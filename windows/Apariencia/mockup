import React, { useState, useEffect } from 'react';
import { 
  Settings, Monitor, Layout, Sliders, Image as ImageIcon, 
  Power, Wifi, Battery, Search, Bell, ChevronRight, Check,
  Terminal, Folder, Compass, Mail, Calendar, MessageCircle,
  Save, Sparkles, Layers, Minimize2, Maximize2, X, RotateCcw,
  Palette, Grid, Moon, Sun, Clock
} from 'lucide-react';

const App = () => {
  // Estado General
  const [activeTab, setActiveTab] = useState('dock');
  const [theme, setTheme] = useState('dark');
  const [showToast, setShowToast] = useState(false);
  const [toastMessage, setToastMessage] = useState('');
  
  // Estado Dock
  const [dockEnabled, setDockEnabled] = useState(true);
  const [dockSize, setDockSize] = useState(56);
  const [magnification, setMagnification] = useState(1.4);
  const [dockPosition, setDockPosition] = useState('bottom'); // 'bottom', 'left', 'right'
  const [dockAutoHide, setDockAutoHide] = useState(false);
  const [hoveredApp, setHoveredApp] = useState(null);

  // Estado Menu Bar
  const [menuBarEnabled, setMenuBarEnabled] = useState(true);
  const [menuBarShowApp, setMenuBarShowApp] = useState(true);
  const [menuBarOpacity, setMenuBarOpacity] = useState(80);

  // Estado Apariencia y Motor
  const [acrylicEnabled, setAcrylicEnabled] = useState(true);
  const [windowShadows, setWindowShadows] = useState(true);
  const [accentColor, setAccentColor] = useState('blue');
  const [dynamicTheme, setDynamicTheme] = useState(false);
  const [wallpaper, setWallpaper] = useState('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop');
  
  // Estado Iconos
  const [activeIconPack, setActiveIconPack] = useState('sonoma');

  const wallpapers = [
    { id: 1, url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop', name: 'Sonoma Abstract' },
    { id: 2, url: 'https://images.unsplash.com/photo-1506744626753-dba37c25a1f1?q=80&w=2070&auto=format&fit=crop', name: 'Yosemite' },
    { id: 3, url: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=2070&auto=format&fit=crop', name: 'Dark Mode' },
  ];

  const iconPacks = [
    { id: 'sonoma', name: 'macOS Sonoma', desc: 'Iconos estilo 3D fluido' },
    { id: 'bigsur', name: 'macOS Big Sur', desc: 'Iconos cuadrados redondeados' },
    { id: 'fluent', name: 'Windows Fluent', desc: 'Estilo nativo moderno' },
  ];

  const handleApplyChanges = () => {
    setToastMessage('Cambios inyectados correctamente en DWM.');
    setShowToast(true);
    setTimeout(() => setShowToast(false), 3000);
  };

  const handleRestoreWindows = () => {
    setDockEnabled(false);
    setMenuBarEnabled(false);
    setWindowShadows(false);
    setAcrylicEnabled(false);
    setActiveIconPack('fluent');
    setToastMessage('Sistema restaurado a la apariencia original de Windows 11.');
    setShowToast(true);
    setTimeout(() => setShowToast(false), 3000);
  };

  const dockApps = [
    { id: 'finder', name: 'Finder', icon: <Folder size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-gradient-to-b from-blue-300 to-blue-500 text-white border border-blue-400' },
    { id: 'safari', name: 'Safari', icon: <Compass size={dockSize * 0.6} strokeWidth={1.5} />, color: 'bg-white text-blue-500 border border-gray-200' },
    { id: 'mail', name: 'Mail', icon: <Mail size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-gradient-to-b from-cyan-400 to-blue-500 text-white border border-blue-400' },
    { id: 'calendar', name: 'Calendar', icon: <Calendar size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-white text-red-500 border border-gray-200' },
    { id: 'messages', name: 'Messages', icon: <MessageCircle size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-gradient-to-b from-green-400 to-green-500 text-white border border-green-500' },
    { id: 'terminal', name: 'Terminal', icon: <Terminal size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-gradient-to-b from-gray-700 to-gray-900 text-white border border-gray-600' },
    { id: 'settings', name: 'Settings', icon: <Settings size={dockSize * 0.55} strokeWidth={1.5} />, color: 'bg-gradient-to-b from-gray-300 to-gray-400 text-gray-800 border border-gray-300' },
  ];

  // Helper para generar clases de posición del dock en la previsualización
  const getDockPositionClasses = () => {
    switch (dockPosition) {
      case 'left': return "absolute top-0 left-4 h-full flex flex-col justify-center perspective-[1000px]";
      case 'right': return "absolute top-0 right-4 h-full flex flex-col justify-center perspective-[1000px]";
      case 'bottom': default: return "absolute bottom-4 left-0 w-full flex justify-center perspective-[1000px]";
    }
  };

  const getDockInnerClasses = () => {
    const baseClasses = `flex items-center space-x-2 rounded-3xl transition-all duration-500 border ${acrylicEnabled ? (theme === 'dark' ? 'bg-white/10 backdrop-blur-2xl border-white/20 shadow-[0_10px_40px_rgba(0,0,0,0.5)]' : 'bg-white/40 backdrop-blur-2xl border-white/50 shadow-[0_10px_40px_rgba(0,0,0,0.1)]') : (theme === 'dark' ? 'bg-zinc-800 border-zinc-700' : 'bg-gray-200 border-gray-300')}`;
    
    if (dockPosition === 'left' || dockPosition === 'right') {
        return `${baseClasses} flex-col space-y-2 space-x-0 py-3 px-2.5`;
    }
    return `${baseClasses} px-3 py-2.5 items-end`; // bottom
  };

  const getAccentColorClass = () => {
      switch(accentColor) {
          case 'purple': return 'from-purple-600 to-purple-400';
          case 'green': return 'from-green-600 to-green-400';
          case 'orange': return 'from-orange-600 to-orange-400';
          case 'blue': default: return 'from-blue-600 to-blue-400';
      }
  }

  return (
    <div className={`min-h-screen font-sans flex flex-col transition-colors duration-500 ${theme === 'dark' ? 'bg-zinc-950 text-gray-100' : 'bg-gray-50 text-gray-900'}`}>
      
      {/* BACKGROUND DECORATION */}
      <div className="fixed inset-0 overflow-hidden pointer-events-none z-0">
        <div className={`absolute -top-[20%] -left-[10%] w-[50%] h-[50%] rounded-full blur-[120px] opacity-20 transition-colors duration-1000 bg-gradient-to-br ${getAccentColorClass()}`} />
        <div className={`absolute top-[40%] -right-[10%] w-[40%] h-[40%] rounded-full blur-[120px] opacity-20 ${theme === 'dark' ? 'bg-indigo-600' : 'bg-indigo-300'}`} />
      </div>

      {/* HEADER */}
      <header className={`relative z-10 p-4 flex items-center justify-between border-b backdrop-blur-xl ${theme === 'dark' ? 'border-white/5 bg-zinc-900/50' : 'border-black/5 bg-white/50'}`}>
        <div className="flex items-center space-x-3 ml-2">
          <div className={`w-10 h-10 rounded-xl shadow-lg bg-gradient-to-br flex items-center justify-center border border-white/20 ${getAccentColorClass()}`}>
            <Sparkles size={20} className="text-white" />
          </div>
          <div>
            <h1 className="text-lg font-bold tracking-tight leading-tight">WinmacOS</h1>
            <p className="text-xs font-medium opacity-60">Transform Engine v3.0 Pro</p>
          </div>
        </div>
        <div className="flex items-center space-x-3 mr-2">
          <button 
            onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
            className={`p-2.5 rounded-xl text-sm font-medium transition-all duration-300 border ${theme === 'dark' ? 'border-white/10 bg-white/5 hover:bg-white/10' : 'border-black/10 bg-black/5 hover:bg-black/10'}`}
            title="Cambiar tema claro/oscuro"
          >
            {theme === 'dark' ? <Sun size={18} /> : <Moon size={18} />}
          </button>
          
          <button 
            onClick={handleRestoreWindows}
            className={`group relative flex items-center space-x-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 border ${theme === 'dark' ? 'border-red-500/30 text-red-400 hover:bg-red-500/10 hover:border-red-500/50' : 'border-red-500/30 text-red-600 hover:bg-red-50 hover:border-red-500/50'}`}
          >
            <RotateCcw size={16} className="group-hover:-rotate-180 transition-transform duration-500" />
            <span>Restaurar Windows</span>
          </button>

          <button 
            onClick={handleApplyChanges}
            className={`group relative flex items-center space-x-2 bg-gradient-to-r hover:opacity-90 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition-all shadow-lg border border-white/20 ${getAccentColorClass()}`}
          >
            <Save size={16} className="group-hover:scale-110 transition-transform" />
            <span>Aplicar Cambios</span>
          </button>
        </div>
      </header>

      {/* TOAST NOTIFICATION */}
      <div className={`fixed top-24 right-8 z-50 transition-all duration-500 transform ${showToast ? 'translate-y-0 opacity-100' : '-translate-y-4 opacity-0 pointer-events-none'}`}>
        <div className={`flex items-center space-x-3 backdrop-blur-xl px-4 py-3 rounded-2xl shadow-2xl border ${toastMessage.includes('restaurado') ? 'bg-red-500/10 border-red-500/20 text-red-500' : 'bg-green-500/10 border-green-500/20 text-green-500'}`}>
          {toastMessage.includes('restaurado') ? <RotateCcw size={20} /> : <Check size={20} />}
          <span className="font-medium text-sm">{toastMessage}</span>
        </div>
      </div>

      <div className="flex flex-1 overflow-hidden relative z-10">
        {/* SIDEBAR */}
        <aside className={`w-72 border-r backdrop-blur-md flex flex-col p-4 gap-2 overflow-y-auto ${theme === 'dark' ? 'border-white/5 bg-zinc-900/30' : 'border-black/5 bg-white/30'}`}>
          <div className="text-[11px] font-bold opacity-50 mb-2 mt-2 uppercase tracking-widest px-2">Estructura Base</div>
          <TabButton id="dock" icon={<Layout size={18} />} label="Dock Principal" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
          <TabButton id="menubar" icon={<Sliders size={18} />} label="Barra Superior" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
          
          <div className="text-[11px] font-bold opacity-50 mb-2 mt-4 uppercase tracking-widest px-2">Diseño y Color</div>
          <TabButton id="theme" icon={<Palette size={18} />} label="Motor de Temas" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
          <TabButton id="icons" icon={<Grid size={18} />} label="Paquetes de Iconos" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
          <TabButton id="appearance" icon={<ImageIcon size={18} />} label="Fondos de Pantalla" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
          
          <div className="text-[11px] font-bold opacity-50 mb-2 mt-4 uppercase tracking-widest px-2">Sistema</div>
          <TabButton id="advanced" icon={<Layers size={18} />} label="Motor de Ventanas" activeTab={activeTab} setActiveTab={setActiveTab} theme={theme} />
        </aside>

        {/* MAIN CONTENT AREA */}
        <main className="flex-1 flex flex-col p-8 overflow-y-auto">
          <div className="max-w-[1400px] w-full mx-auto space-y-8">
            
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
              
              {/* CONFIGURATION PANEL (LEFT/TOP) */}
              <div className={`lg:col-span-5 xl:col-span-4 p-6 rounded-3xl border shadow-xl backdrop-blur-xl transition-all h-fit ${theme === 'dark' ? 'bg-zinc-900/60 border-white/10' : 'bg-white/80 border-black/5'}`}>
                <h2 className={`text-xl font-bold mb-6 flex items-center bg-clip-text text-transparent bg-gradient-to-r ${getAccentColorClass()}`}>
                  {activeTab === 'dock' && 'Configuración del Dock'}
                  {activeTab === 'menubar' && 'Ajustes de Menu Bar'}
                  {activeTab === 'appearance' && 'Gestión de Fondos'}
                  {activeTab === 'theme' && 'Motor de Temas y Color'}
                  {activeTab === 'icons' && 'Sistema de Iconos'}
                  {activeTab === 'advanced' && 'Inyección de Ventanas'}
                </h2>

                {activeTab === 'dock' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <SettingToggle title="Habilitar Dock Interactivo" description="Reemplaza la barra de tareas nativa." enabled={dockEnabled} onChange={() => setDockEnabled(!dockEnabled)} theme={theme} />
                    
                    <div className={`p-4 rounded-2xl border ${theme === 'dark' ? 'bg-white/5 border-white/5' : 'bg-black/5 border-black/5'} space-y-4`}>
                      <label className="text-sm font-semibold">Posición en Pantalla</label>
                      <div className="grid grid-cols-3 gap-2">
                        {['left', 'bottom', 'right'].map(pos => (
                          <button
                            key={pos}
                            onClick={() => setDockPosition(pos)}
                            className={`py-2 rounded-xl text-xs font-semibold capitalize transition-all border ${dockPosition === pos ? `bg-gradient-to-r text-white shadow-md border-transparent ${getAccentColorClass()}` : `${theme === 'dark' ? 'bg-black/20 border-white/10 hover:bg-white/10' : 'bg-white border-black/10 hover:bg-black/5'}`}`}
                          >
                            {pos === 'bottom' ? 'Abajo' : pos === 'left' ? 'Izquierda' : 'Derecha'}
                          </button>
                        ))}
                      </div>
                    </div>

                    <SettingToggle title="Ocultar Automáticamente" description="El Dock se esconde cuando no está en uso." enabled={dockAutoHide} onChange={() => setDockAutoHide(!dockAutoHide)} theme={theme} />

                    <div className={`p-5 rounded-2xl border ${theme === 'dark' ? 'bg-black/20 border-white/5' : 'bg-gray-100/50 border-black/5'} space-y-5`}>
                      <RangeSlider label="Tamaño de Iconos" value={dockSize} min="32" max="96" unit="px" onChange={(e) => setDockSize(Number(e.target.value))} theme={theme} />
                      <RangeSlider label="Nivel de Magnificación" value={magnification} min="1" max="2" step="0.1" unit="x" onChange={(e) => setMagnification(Number(e.target.value))} theme={theme} />
                    </div>
                  </div>
                )}

                {activeTab === 'menubar' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <SettingToggle title="Habilitar Barra Superior" description="Barra global persistente." enabled={menuBarEnabled} onChange={() => setMenuBarEnabled(!menuBarEnabled)} theme={theme} />
                    <SettingToggle title="Mostrar App Activa" description="Muestra el nombre del programa en foco junto al logo." enabled={menuBarShowApp} onChange={() => setMenuBarShowApp(!menuBarShowApp)} theme={theme} />
                    
                    <div className={`p-5 rounded-2xl border ${theme === 'dark' ? 'bg-black/20 border-white/5' : 'bg-gray-100/50 border-black/5'}`}>
                      <RangeSlider label="Opacidad del Fondo" value={menuBarOpacity} min="0" max="100" unit="%" onChange={(e) => setMenuBarOpacity(Number(e.target.value))} theme={theme} />
                    </div>

                    <div className="grid grid-cols-2 gap-3">
                       <ModuleCard icon={<Wifi size={18}/>} title="Red" active theme={theme} />
                       <ModuleCard icon={<Battery size={18}/>} title="Batería" active theme={theme} />
                       <ModuleCard icon={<Search size={18}/>} title="Spotlight" active theme={theme} />
                       <ModuleCard icon={<Bell size={18}/>} title="Notificaciones" active theme={theme} />
                    </div>
                  </div>
                )}

                {activeTab === 'theme' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <SettingToggle title="Tema Dinámico" description="Cambia entre claro/oscuro según la hora del día." enabled={dynamicTheme} onChange={() => setDynamicTheme(!dynamicTheme)} theme={theme} />
                    <SettingToggle title="Materiales Translúcidos" description="Usa Acrylic/Mica para difuminar fondos." enabled={acrylicEnabled} onChange={() => setAcrylicEnabled(!acrylicEnabled)} theme={theme} />
                    
                    <div className={`p-4 rounded-2xl border ${theme === 'dark' ? 'bg-white/5 border-white/5' : 'bg-black/5 border-black/5'} space-y-4`}>
                      <label className="text-sm font-semibold">Color de Acento Principal</label>
                      <div className="flex space-x-3">
                        {['blue', 'purple', 'green', 'orange'].map(color => (
                          <button
                            key={color}
                            onClick={() => setAccentColor(color)}
                            className={`w-10 h-10 rounded-full flex items-center justify-center transition-all ${accentColor === color ? 'ring-2 ring-offset-2 scale-110' : 'hover:scale-105 opacity-80 hover:opacity-100'} ${theme === 'dark' ? 'ring-offset-zinc-900' : 'ring-offset-white'}`}
                            style={{
                              backgroundColor: color === 'blue' ? '#3b82f6' : color === 'purple' ? '#9333ea' : color === 'green' ? '#16a34a' : '#ea580c',
                              ringColor: color === 'blue' ? '#3b82f6' : color === 'purple' ? '#9333ea' : color === 'green' ? '#16a34a' : '#ea580c'
                            }}
                          >
                            {accentColor === color && <Check size={16} className="text-white" />}
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {activeTab === 'icons' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <div className="space-y-3">
                      {iconPacks.map(pack => (
                        <div 
                          key={pack.id}
                          onClick={() => setActiveIconPack(pack.id)}
                          className={`p-4 rounded-xl border flex items-center justify-between cursor-pointer transition-all ${activeIconPack === pack.id ? `border-transparent shadow-md bg-gradient-to-r ${getAccentColorClass()} text-white` : `${theme === 'dark' ? 'bg-white/5 border-white/10 hover:bg-white/10' : 'bg-black/5 border-black/5 hover:bg-black/10'}`}`}
                        >
                          <div>
                            <h4 className="font-semibold text-sm">{pack.name}</h4>
                            <p className={`text-xs mt-0.5 ${activeIconPack === pack.id ? 'text-white/80' : 'opacity-60'}`}>{pack.desc}</p>
                          </div>
                          {activeIconPack === pack.id ? <Check size={20} /> : <div className="w-5 h-5 rounded-full border border-current opacity-30"></div>}
                        </div>
                      ))}
                    </div>
                    <div className={`p-4 rounded-xl text-sm border ${theme === 'dark' ? 'bg-blue-500/10 border-blue-500/20 text-blue-400' : 'bg-blue-50 border-blue-200 text-blue-700'}`}>
                      <p className="opacity-80">El cambio de iconos modifica accesos directos y asociaciones del registro de forma segura, sin tocar archivos DLL del sistema.</p>
                    </div>
                  </div>
                )}

                {activeTab === 'appearance' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <div className="space-y-3">
                      <label className="text-sm font-semibold flex justify-between items-center">
                        <span>Fondo de Pantalla Activo</span>
                        <span className="text-xs font-normal opacity-60">Previsualización</span>
                      </label>
                      <div className="grid grid-cols-2 gap-3">
                        {wallpapers.map(wp => (
                          <button 
                            key={wp.id} 
                            onClick={() => setWallpaper(wp.url)}
                            className={`relative aspect-video rounded-xl overflow-hidden border-2 transition-all group ${wallpaper === wp.url ? 'border-blue-500 shadow-lg scale-105 z-10' : 'border-transparent hover:scale-105 opacity-80 hover:opacity-100'}`}
                          >
                            <img src={wp.url} alt={wp.name} className="w-full h-full object-cover" />
                            <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                               <span className="text-white text-xs font-semibold">Seleccionar</span>
                            </div>
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {activeTab === 'advanced' && (
                  <div className="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-500">
                    <SettingToggle title="Sombras Realistas (Drop Shadow)" description="Aplica sombras profundas a todas las ventanas abiertas." enabled={windowShadows} onChange={() => setWindowShadows(!windowShadows)} theme={theme} />
                    <SettingToggle title="Forzar Bordes Redondeados" description="Inyecta esquinas suaves en aplicaciones Win32 antiguas." enabled={true} onChange={() => {}} theme={theme} />
                    <div className={`p-4 rounded-xl text-sm border ${theme === 'dark' ? 'bg-orange-500/10 border-orange-500/20 text-orange-400' : 'bg-orange-50 border-orange-200 text-orange-700'}`}>
                      <p className="font-semibold mb-1 flex items-center"><Terminal size={14} className="mr-2"/> Cuidado (Hooks de Sistema)</p>
                      <p className="opacity-80">Estas opciones inyectan código en el Desktop Window Manager (DWM). Pueden causar inestabilidad si otro software modifica las ventanas.</p>
                    </div>
                  </div>
                )}

              </div>

              {/* LIVE PREVIEW AREA (RIGHT/BOTTOM) */}
              <div className="lg:col-span-7 xl:col-span-8 flex flex-col">
                <div className="mb-4 flex items-center justify-between">
                  <h3 className="text-sm font-bold tracking-widest uppercase opacity-50 flex items-center">
                    <Monitor className="mr-2" size={16} /> Live Desktop Preview
                  </h3>
                  <div className="flex space-x-2">
                    <span className="flex h-3 w-3"><span className={`animate-ping absolute inline-flex h-3 w-3 rounded-full opacity-75 ${accentColor === 'blue' ? 'bg-blue-400' : 'bg-current'}`}></span><span className={`relative inline-flex rounded-full h-3 w-3 ${accentColor === 'blue' ? 'bg-blue-500' : 'bg-current'}`}></span></span>
                  </div>
                </div>
                
                <div 
                  className={`relative w-full aspect-[16/10] rounded-3xl overflow-hidden shadow-2xl border-4 transition-all duration-500 ${theme === 'dark' ? 'border-zinc-800 ring-1 ring-white/10' : 'border-gray-300 ring-1 ring-black/10'}`} 
                  style={{ 
                    backgroundImage: `url('${wallpaper}')`,
                    backgroundSize: 'cover',
                    backgroundPosition: 'center'
                  }}
                >
                  
                  {/* PREVIEW MENU BAR */}
                  {menuBarEnabled && (
                    <div className={`absolute top-0 left-0 w-full h-7 flex items-center justify-between px-4 text-[13px] font-medium transition-all duration-300 z-40
                      ${acrylicEnabled 
                        ? (theme === 'dark' ? 'text-white backdrop-blur-md border-b border-white/10' : 'text-black backdrop-blur-md border-b border-black/10') 
                        : (theme === 'dark' ? 'text-white' : 'text-black')}`}
                      style={{ backgroundColor: acrylicEnabled ? (theme === 'dark' ? `rgba(0,0,0,${menuBarOpacity/100})` : `rgba(255,255,255,${menuBarOpacity/100})`) : (theme === 'dark' ? '#18181b' : '#ffffff') }}
                    >
                      <div className="flex items-center space-x-4">
                        <div className="font-bold text-lg leading-none mb-1"></div>
                        {menuBarShowApp && <div className="font-bold cursor-default">Finder</div>}
                        <div className="cursor-default opacity-90 hover:opacity-100">File</div>
                        <div className="cursor-default opacity-90 hover:opacity-100">Edit</div>
                        <div className="cursor-default opacity-90 hover:opacity-100">View</div>
                        <div className="cursor-default opacity-90 hover:opacity-100">Window</div>
                        <div className="cursor-default opacity-90 hover:opacity-100">Help</div>
                      </div>
                      <div className="flex items-center space-x-4 opacity-90">
                        <Wifi size={14} />
                        <Battery size={14} />
                        <Search size={14} />
                        <span>Mon 9:41 AM</span>
                      </div>
                    </div>
                  )}

                  {/* FAKE FINDER WINDOW (To show shadows and rounded corners) */}
                  <div className={`absolute top-[20%] left-[20%] w-[50%] h-[45%] flex flex-col rounded-xl overflow-hidden transition-all duration-500 border z-20
                    ${theme === 'dark' ? 'bg-zinc-900/80 border-white/10' : 'bg-white/80 border-black/10'}
                    ${acrylicEnabled ? 'backdrop-blur-2xl' : ''}
                    ${windowShadows ? 'shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]' : 'shadow-none'}
                  `}>
                    {/* Toolbar */}
                    <div className={`h-12 flex items-center px-4 border-b ${theme === 'dark' ? 'border-white/10' : 'border-black/5'}`}>
                      <div className="flex space-x-2 mr-6">
                        <div className="w-3 h-3 rounded-full bg-red-500 border border-red-600/50"></div>
                        <div className="w-3 h-3 rounded-full bg-yellow-500 border border-yellow-600/50"></div>
                        <div className="w-3 h-3 rounded-full bg-green-500 border border-green-600/50"></div>
                      </div>
                      <div className={`flex-1 flex justify-center text-sm font-semibold opacity-70 ${theme === 'dark' ? 'text-white' : 'text-black'}`}>
                        Applications
                      </div>
                    </div>
                    {/* Content */}
                    <div className="flex-1 p-6 grid grid-cols-4 gap-4">
                      {[1, 2, 3, 4].map(i => (
                        <div key={i} className="flex flex-col items-center space-y-2 opacity-50 hover:opacity-100 cursor-pointer transition-opacity">
                          <Folder size={32} className={activeIconPack === 'fluent' ? 'text-yellow-400 fill-yellow-400' : 'text-blue-400'} />
                          <div className={`h-1.5 w-12 rounded-full ${theme === 'dark' ? 'bg-white/30' : 'bg-black/20'}`}></div>
                        </div>
                      ))}
                    </div>
                  </div>

                  {/* PREVIEW DOCK */}
                  {dockEnabled && (
                    <div className={`${getDockPositionClasses()} z-30 transition-all duration-500 ${dockAutoHide ? 'opacity-30 hover:opacity-100' : 'opacity-100'}`}>
                      <div className={getDockInnerClasses()}>
                        {dockApps.map((app, index) => (
                          <div 
                            key={app.id}
                            className={`relative flex flex-col items-center group cursor-pointer ${dockPosition === 'bottom' ? 'origin-bottom' : dockPosition === 'left' ? 'origin-left' : 'origin-right'}`}
                            style={{ width: `${dockSize}px`, height: `${dockSize}px` }}
                            onMouseEnter={() => setHoveredApp(app.id)}
                            onMouseLeave={() => setHoveredApp(null)}
                          >
                            {/* Tooltip Nombre App */}
                            <div className={`absolute px-3 py-1 rounded-md text-xs font-semibold whitespace-nowrap transition-all duration-200 pointer-events-none shadow-lg z-50
                              ${dockPosition === 'bottom' ? '-top-12' : dockPosition === 'left' ? 'left-[calc(100%+10px)] top-1/2 -translate-y-1/2' : 'right-[calc(100%+10px)] top-1/2 -translate-y-1/2'}
                              ${hoveredApp === app.id ? 'opacity-100 scale-100' : 'opacity-0 scale-95'}
                              ${theme === 'dark' ? 'bg-zinc-800 text-white border border-white/10' : 'bg-white text-black border border-black/5'}
                            `}>
                              {app.name}
                            </div>

                            {/* Icono */}
                            <div 
                              className={`w-full h-full rounded-[22%] flex items-center justify-center shadow-md transition-all duration-300 ease-out 
                                ${activeIconPack === 'fluent' ? 'bg-transparent text-current opacity-80' : app.color}`}
                              style={{ 
                                transform: hoveredApp === app.id 
                                  ? `scale(${magnification}) ${dockPosition === 'bottom' ? 'translateY(-10px)' : dockPosition === 'left' ? 'translateX(10px)' : 'translateX(-10px)'}` 
                                  : 'scale(1) translate(0)',
                                zIndex: hoveredApp === app.id ? 50 : 1,
                              }}
                            >
                              {activeIconPack === 'fluent' && app.id === 'finder' ? <Folder size={dockSize*0.6} className="fill-yellow-400 text-yellow-500" /> : app.icon}
                            </div>
                            
                            {/* Indicador Activo */}
                            {index < 3 && (
                              <div className={`absolute rounded-full ${theme === 'dark' ? 'bg-white/80' : 'bg-black/60'}
                                ${dockPosition === 'bottom' ? '-bottom-2 w-1 h-1' : dockPosition === 'left' ? '-left-1.5 top-1/2 -translate-y-1/2 w-1 h-1' : '-right-1.5 top-1/2 -translate-y-1/2 w-1 h-1'}
                              `}></div>
                            )}
                          </div>
                        ))}
                        
                        {/* Separador */}
                        <div className={`rounded-full ${theme === 'dark' ? 'bg-white/20' : 'bg-black/20'}
                           ${dockPosition === 'bottom' ? 'w-[1px] h-3/4 mx-1 self-center' : 'h-[1px] w-3/4 my-1 self-center'}
                        `}></div>
                        
                        {/* Papelera */}
                        <div 
                          className={`relative flex flex-col items-center cursor-pointer ${dockPosition === 'bottom' ? 'origin-bottom' : dockPosition === 'left' ? 'origin-left' : 'origin-right'}`}
                          style={{ width: `${dockSize}px`, height: `${dockSize}px` }}
                          onMouseEnter={() => setHoveredApp('trash')}
                          onMouseLeave={() => setHoveredApp(null)}
                        >
                           <div className={`absolute px-3 py-1 rounded-md text-xs font-semibold whitespace-nowrap transition-all duration-200 pointer-events-none shadow-lg z-50
                              ${dockPosition === 'bottom' ? '-top-12' : dockPosition === 'left' ? 'left-[calc(100%+10px)] top-1/2 -translate-y-1/2' : 'right-[calc(100%+10px)] top-1/2 -translate-y-1/2'}
                              ${hoveredApp === 'trash' ? 'opacity-100 scale-100' : 'opacity-0 scale-95'}
                              ${theme === 'dark' ? 'bg-zinc-800 text-white border border-white/10' : 'bg-white text-black border border-black/5'}
                            `}>
                              Trash
                          </div>
                          <div 
                            className={`w-full h-full rounded-[22%] flex items-center justify-center transition-all duration-300 ease-out border shadow-inner
                              ${theme === 'dark' ? 'bg-white/5 border-white/20 text-white/80' : 'bg-black/5 border-black/10 text-black/60'}`}
                            style={{ 
                              transform: hoveredApp === 'trash' 
                                  ? `scale(${magnification}) ${dockPosition === 'bottom' ? 'translateY(-10px)' : dockPosition === 'left' ? 'translateX(10px)' : 'translateX(-10px)'}` 
                                  : 'scale(1) translate(0)',
                            }}
                          >
                            <svg className="w-1/2 h-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* FAKE WINDOWS 11 TASKBAR (Shows when Dock is disabled) */}
                  {!dockEnabled && (
                    <div className={`absolute bottom-0 left-0 w-full h-12 flex items-center px-4 backdrop-blur-2xl transition-all duration-500 border-t z-50
                      ${theme === 'dark' ? 'bg-zinc-900/80 border-white/10 text-white' : 'bg-white/80 border-black/10 text-black'}
                    `}>
                      <div className="flex items-center space-x-2 opacity-80 hover:opacity-100 cursor-default">
                        <Monitor size={16} className="text-blue-400"/>
                        <span className="text-[11px] font-medium">24°C Soleado</span>
                      </div>
                      <div className="absolute left-1/2 transform -translate-x-1/2 flex items-center space-x-1">
                        <div className={`w-9 h-9 rounded-md flex items-center justify-center cursor-pointer transition-colors ${theme === 'dark' ? 'hover:bg-white/10' : 'hover:bg-black/5'}`}>
                          <div className="w-5 h-5 bg-blue-500 rounded-sm grid grid-cols-2 gap-0.5 p-0.5">
                            <div className="bg-white rounded-[1px]"></div><div className="bg-white rounded-[1px]"></div>
                            <div className="bg-white rounded-[1px]"></div><div className="bg-white rounded-[1px]"></div>
                          </div>
                        </div>
                        <div className={`w-9 h-9 rounded-md flex items-center justify-center cursor-pointer transition-colors ${theme === 'dark' ? 'hover:bg-white/10' : 'hover:bg-black/5'}`}>
                          <Search size={18} />
                        </div>
                        <div className={`w-9 h-9 rounded-md flex items-center justify-center cursor-pointer transition-colors ${theme === 'dark' ? 'hover:bg-white/10' : 'hover:bg-black/5'}`}>
                          <Folder size={18} className="text-yellow-400 fill-yellow-400" />
                        </div>
                      </div>
                      <div className="ml-auto flex items-center space-x-3 opacity-90 cursor-default">
                        <ChevronRight size={14} />
                        <div className={`flex items-center space-x-2 px-2 py-1 rounded-md transition-colors ${theme === 'dark' ? 'hover:bg-white/10' : 'hover:bg-black/5'}`}>
                          <Wifi size={14} />
                          <Battery size={14} />
                        </div>
                        <div className={`flex flex-col items-end justify-center leading-tight px-2 py-0.5 rounded-md transition-colors ${theme === 'dark' ? 'hover:bg-white/10' : 'hover:bg-black/5'}`}>
                          <span className="text-[11px] font-medium">14:30</span>
                          <span className="text-[11px] font-medium">24/10/2023</span>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>

            </div>
          </div>
        </main>
      </div>
    </div>
  );
};

/* --- COMPONENTES AUXILIARES --- */

const TabButton = ({ id, icon, label, activeTab, setActiveTab, theme }) => {
  const isActive = activeTab === id;
  return (
    <button
      onClick={() => setActiveTab(id)}
      className={`flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-300 ${
        isActive 
          ? 'bg-white/10 text-current shadow-sm translate-x-1 ring-1 ring-white/20' 
          : `${theme === 'dark' ? 'text-gray-400 hover:text-white hover:bg-white/5' : 'text-gray-600 hover:text-black hover:bg-black/5'}`
      }`}
    >
      <span className={isActive ? 'opacity-100 text-blue-500' : 'opacity-70'}>{icon}</span>
      <span>{label}</span>
    </button>
  );
};

const SettingToggle = ({ title, description, enabled, onChange, theme }) => (
  <div className={`flex items-center justify-between p-4 rounded-2xl border transition-colors ${theme === 'dark' ? 'bg-white/5 border-white/10 hover:bg-white/10' : 'bg-black/5 border-black/5 hover:bg-black/10'}`}>
    <div className="pr-4">
      <h3 className="font-semibold text-sm">{title}</h3>
      <p className={`text-xs mt-1 ${theme === 'dark' ? 'text-gray-400' : 'text-gray-500'}`}>{description}</p>
    </div>
    <button 
      onClick={onChange}
      className={`relative inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full transition-colors duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 ${theme === 'dark' ? 'focus:ring-offset-zinc-900' : 'focus:ring-offset-white'} ${enabled ? 'bg-blue-500' : theme === 'dark' ? 'bg-zinc-700' : 'bg-gray-300'}`}
    >
      <span className={`inline-block h-4 w-4 transform rounded-full bg-white shadow-md transition-transform duration-300 ${enabled ? 'translate-x-6' : 'translate-x-1'}`} />
    </button>
  </div>
);

const RangeSlider = ({ label, value, min, max, step = "1", unit, onChange, theme }) => (
  <div>
    <div className="flex justify-between mb-2">
      <label className="font-semibold text-xs">{label}</label>
      <span className={`text-xs font-bold bg-blue-500/10 text-blue-500 px-2 py-0.5 rounded-md`}>{value}{unit}</span>
    </div>
    <input 
      type="range" min={min} max={max} step={step} value={value} 
      onChange={onChange}
      className={`w-full h-1.5 rounded-lg appearance-none cursor-pointer transition-all ${theme === 'dark' ? 'bg-zinc-700 accent-blue-500 hover:bg-zinc-600' : 'bg-gray-300 accent-blue-500 hover:bg-gray-400'}`}
    />
  </div>
);

const ModuleCard = ({ icon, title, active, theme }) => (
  <div className={`p-3 rounded-xl border flex items-center space-x-3 transition-colors ${theme === 'dark' ? 'bg-white/5 border-white/10' : 'bg-black/5 border-black/5'}`}>
    <div className={`p-1.5 rounded-lg ${active ? 'bg-blue-500/20 text-blue-500' : 'bg-gray-500/20 text-gray-500'}`}>
      {icon}
    </div>
    <span className="font-semibold text-xs">{title}</span>
  </div>
);

export default App;