            zone?.addEventListener('touchend', rJoy); zone?.addEventListener('touchcancel', rJoy);
            function updateJoy(tx, ty) { let dx = tx - jCenter.x, dy = ty - jCenter.y; const max = 40, dist = Math.hypot(dx, dy); if(dist > max) { dx = (dx/dist)*max; dy = (dy/dist)*max; } knob.style.transform = `translate(${dx}px, ${dy}px)`; joystick.x = dx/max; joystick.y = dy/max; }

