        function buildWorld(textures) {
            const groundMat = new THREE.MeshStandardMaterial({ color: 0x475569, roughness: 1.0 });
            const ground = new THREE.Mesh(new THREE.PlaneGeometry(CITY_SIZE * 2, CITY_SIZE * 2), groundMat);
            ground.rotation.x = -Math.PI / 2; ground.position.y = -0.1; ground.receiveShadow = true; scene.add(ground);

            const roadMat = new THREE.MeshStandardMaterial({ map: textures.roadDiffuse, normalMap: textures.asphaltNormalMap, normalScale: new THREE.Vector2(0.8, 0.8), roughness: 0.7, metalness: 0.1 });
            const roofMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.9 });
            const sideMat = new THREE.MeshStandardMaterial({ map: textures.sideDiffuse, roughness: 0.9 });

            for (let x = -HALF_CITY; x <= HALF_CITY; x += BLOCK_SIZE) {
                for (let z = -HALF_CITY; z <= HALF_CITY; z += BLOCK_SIZE) {
                    createRoads(x, z, roadMat);

                    if (x === CARTEL_X && z === CARTEL_Z) { createCartelWarehouse(x, z); sidewalks.push({x: x + BLOCK_SIZE/2, z: z + BLOCK_SIZE/2}); continue; }
                    if (x === DEALER_X && z === DEALER_Z) { createDealership(x, z); sidewalks.push({x: x + BLOCK_SIZE/2, z: z + BLOCK_SIZE/2}); continue; }
                    if (x === ARMORY_X && z === ARMORY_Z) { createArmory(x, z); sidewalks.push({x: x + BLOCK_SIZE/2, z: z + BLOCK_SIZE/2}); continue; }
                    if (Math.abs(x) < BLOCK_SIZE && Math.abs(z) < BLOCK_SIZE && x===0 && z===0) { createCentralPark(); sidewalks.push({x: x + BLOCK_SIZE/2, z: z + BLOCK_SIZE/2}); continue; }

                    const blockW = BLOCK_SIZE - ROAD_WIDTH; 
                    
                    const blockGeo = new THREE.BoxGeometry(blockW, 0.3, blockW);
                    const block = new THREE.Mesh(blockGeo, sideMat);
                    block.position.set(x + BLOCK_SIZE/2, 0.15, z + BLOCK_SIZE/2); 
                    block.receiveShadow = true; block.castShadow = true; scene.add(block);
                    sidewalks.push({x: x + BLOCK_SIZE/2, z: z + BLOCK_SIZE/2, w: blockW});

                    let dist = Math.hypot(x, z);
                    let blockMats = textures.commMats; 
                    if (dist > 400 && dist <= 1000) blockMats = textures.resMats; 
                    if (dist > 1000) blockMats = textures.indMats; 

                    generateSkyscrapers(x + BLOCK_SIZE/2, z + BLOCK_SIZE/2, blockW, blockMats, roofMat);
                    createStreetProps(x + BLOCK_SIZE/2, z + BLOCK_SIZE/2);
                }
            }
        }

