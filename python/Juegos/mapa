                inVehicle = true; currentVehicle = closestInteractable;
                currentVehicle.isAI = false; currentVehicle.speed = 0; player.visible = false; equipWeapon('none'); 
                currentVehicle.mesh.add(globalHeadlights); globalHeadlights.visible = true; cameraAngles.theta = currentVehicle.heading + Math.PI / 2; 
            } else if (inVehicle && currentVehicle) {
                inVehicle = false; player.position.copy(currentVehicle.mesh.position);
                player.position.x += Math.cos(currentVehicle.heading) * 2; player.position.z -= Math.sin(currentVehicle.heading) * 2;
