<Window x:Class="Apariencia.UI.MenuBar.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="macOS Menu Bar" Height="30" Width="1920"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    
    <Border Background="#CC000000" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
        <Grid Margin="15,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="" Foreground="White" FontSize="18" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="Finder" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.8">
                    <TextBlock Text="File" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="Edit" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="View" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="Go" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="Window" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                    <TextBlock Text="Help" Foreground="White" FontSize="12" Margin="0,0,12,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8">
                <TextBlock Text="Mon 9:41 AM" Foreground="White" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
