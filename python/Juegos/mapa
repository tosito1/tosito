                const pts = [new THREE.Vector3(player.position.x, 0.5, player.position.z), new THREE.Vector3(waypoint.x, 0.5, waypoint.z)];
                const geo = new THREE.BufferGeometry().setFromPoints(pts); gpsBeaconLine = new THREE.Line(geo, mat); gpsBeaconLine.computeLineDistances(); scene.add(gpsBeaconLine);
                const beamGeo = new THREE.CylinderGeometry(2, 2, 500, 8); const beamMat = new THREE.MeshBasicMaterial({ color: 0xef4444, transparent: true, opacity: 0.3, blending: THREE.AdditiveBlending, side: THREE.DoubleSide });
                gpsBeaconBeam = new THREE.Mesh(beamGeo, beamMat); gpsBeaconBeam.position.set(waypoint.x, 250, waypoint.z); scene.add(gpsBeaconBeam);
            }
        }

        function checkCollisions(pos) { const box = new THREE.Box3().setFromCenterAndSize(new THREE.Vector3(pos.x, pos.y + 0.8, pos.z), new THREE.Vector3(0.6, 1.6, 0.6)); return buildings.some(b => box.intersectsBox(b)); }
        function checkCarCollisions(carBox) { return buildings.some(b => carBox.intersectsBox(b)); }

        function animate() {
            requestAnimationFrame(animate);
            if (isMapOpen || isInventoryOpen) { if(isMapOpen) drawMap(); return; } // Pausa renderizado si hay UI
            
            const delta = Math.min(clock.getDelta(), 0.1); 
            if (interactCooldown > 0) interactCooldown -= delta;

            if (isShooting) shootWeapon();
            if (muzzleFlash && muzzleFlash.intensity > 0) { muzzleFlash.intensity -= delta * 15; if (muzzleFlash.intensity < 0) muzzleFlash.intensity = 0; }
            
            groundItems.forEach(item => { item.mesh.rotation.y += 0.02; });

            for (let i = tracers.length - 1; i >= 0; i--) { tracers[i].life -= delta * 20; tracers[i].mesh.material.opacity = tracers[i].life; if (tracers[i].life <= 0) { scene.remove(tracers[i].mesh); tracers[i].mesh.geometry.dispose(); tracers[i].mesh.material.dispose(); tracers.splice(i, 1); } }
            for (let i = impactParticles.length - 1; i >= 0; i--) { const p = impactParticles[i]; p.life -= delta * 4; p.velocity.y += gravity * delta * 0.2; p.mesh.position.addScaledVector(p.velocity, delta); p.mesh.material.opacity = p.life; p.mesh.scale.setScalar(Math.max(p.life, 0.01)); if (p.life <= 0) { scene.remove(p.mesh); p.mesh.geometry.dispose(); p.mesh.material.dispose(); impactParticles.splice(i, 1); } }

            cars.forEach(car => {
                if (car.isAI) {
                    let carInFront = false; let forward = new THREE.Vector3(1, 0, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), car.heading);
                    for(let other of cars) {
                        if(other !== car) {
                            let dist = car.mesh.position.distanceTo(other.mesh.position);
                            if(dist > 0 && dist < 22) { 
                                let dirToOther = other.mesh.position.clone().sub(car.mesh.position).normalize();
                                if(dirToOther.dot(forward) > 0.8) { carInFront = true; break; }
                            }
                        }
                    }
                    if (!inVehicle) {
                        if (car.mesh.position.distanceTo(player.position) < 18) {
                            let dirToPlayer = player.position.clone().sub(car.mesh.position).normalize();
                            if (dirToPlayer.dot(forward) > 0.8) carInFront = true;
                        }
                    } else if (currentVehicle && currentVehicle !== car) {
                        if (car.mesh.position.distanceTo(currentVehicle.mesh.position) < 25) {
                            let dirToPlayerCar = currentVehicle.mesh.position.clone().sub(car.mesh.position).normalize();
                            if (dirToPlayerCar.dot(forward) > 0.8) carInFront = true;
                        }
                    }

                    if (carInFront) { car.speed = Math.max(0, car.speed - delta * 30); if(car.tailLightMat) car.tailLightMat.emissiveIntensity = 8.0; 
                    } else { car.speed = Math.min(car.maxSpeed, car.speed + delta * 6); if(car.tailLightMat) car.tailLightMat.emissiveIntensity = 2.0; }

                    if (car.isAxisX) { car.mesh.position.x += car.direction * car.speed * delta; if (car.mesh.position.x > HALF_CITY) car.mesh.position.x = -HALF_CITY; if (car.mesh.position.x < -HALF_CITY) car.mesh.position.x = HALF_CITY; 
                    } else { car.mesh.position.z += car.direction * car.speed * delta; if (car.mesh.position.z > HALF_CITY) car.mesh.position.z = -HALF_CITY; if (car.mesh.position.z < -HALF_CITY) car.mesh.position.z = HALF_CITY; }
                    car.wheels.forEach(w => w.rotation.y += car.speed * delta * 0.5);
                }
            });

            const camForward = new THREE.Vector3(); camera.getWorldDirection(camForward); camForward.y = 0; camForward.normalize();
            const camRight = new THREE.Vector3(); camRight.crossVectors(camera.up, camForward).normalize();
            let iX = 0, iZ = 0;
            if (isLocked || !isMobile) { if (keys.w) iZ += 1; if (keys.s) iZ -= 1; if (keys.a) iX += 1; if (keys.d) iX -= 1; }
            if (joystick.active) { iX -= joystick.x; iZ -= joystick.y; }
            const inputDir = new THREE.Vector3(iX, 0, iZ).normalize();

            if (!inVehicle) {
                const isRunning = keys.shift;
                let speed = isRunning ? moveSpeed * 1.8 : moveSpeed;
                
                if (inputDir.lengthSq() > 0) {
                    direction.copy(camForward).multiplyScalar(inputDir.z).add(camRight.multiplyScalar(inputDir.x)).normalize(); 
                    velocity.x = direction.x * speed; velocity.z = direction.z * speed;
                    
                    const targetRot = Math.atan2(velocity.x, velocity.z); let diff = targetRot - player.rotation.y; 
                    while(diff < -Math.PI) diff += Math.PI*2; while(diff > Math.PI) diff -= Math.PI*2;
                    player.rotation.y += diff * 0.15; 
                    
                    const animSpeed = isRunning ? speed * 0.5 : speed * 0.4; 
                    walkCycle += delta * animSpeed;
                    
                    const armSwing = isRunning ? 2.0 : 1.2;
                    const legSwing = isRunning ? 1.5 : 1.0;

                    playerRig.armL.rotation.x = Math.sin(walkCycle) * armSwing;
                    
                    if (activeWeapon !== 'none') { 
                        playerRig.armR.rotation.x = -Math.PI / 2.2; playerRig.armR.rotation.z = Math.PI / 12; 
                    } else { 
                        playerRig.armR.rotation.x = Math.sin(walkCycle + Math.PI) * armSwing; playerRig.armR.rotation.z = 0; 
                    }
                    
                    playerRig.legL.rotation.x = Math.sin(walkCycle + Math.PI) * legSwing; 
                    playerRig.legR.rotation.x = Math.sin(walkCycle) * legSwing; 
                    
                    playerRig.torso.position.y = 1.1 + Math.abs(Math.sin(walkCycle*2)) * (isRunning ? 0.08 : 0.04);
                    playerRig.torso.rotation.y = Math.sin(walkCycle) * (isRunning ? 0.15 : 0.05); 
                } else {
                    velocity.x *= 0.8; velocity.z *= 0.8; 
                    walkCycle += delta * 1.5; 
                    
                    playerRig.torso.position.y = 1.1 + Math.sin(walkCycle) * 0.02;
                    playerRig.armL.rotation.x = Math.sin(walkCycle) * 0.05;
                    
                    if (activeWeapon !== 'none') { 
                        playerRig.armR.rotation.x = -Math.PI / 2.2; playerRig.armR.rotation.z = Math.PI / 12; 
                    } else { 
                        playerRig.armR.rotation.x = Math.sin(walkCycle + Math.PI) * 0.05; playerRig.armR.rotation.z *= 0.8; 
                    }
                    
                    playerRig.legL.rotation.x *= 0.8; playerRig.legR.rotation.x *= 0.8; 
                    playerRig.torso.rotation.y *= 0.8;
                }

                velocity.y += gravity * delta; if (keys.space && onGround) { velocity.y = jumpVelocity; onGround = false; }
                let nPos = player.position.clone();
                nPos.x += velocity.x * delta; if(checkCollisions(nPos)) { nPos.x -= velocity.x * delta; velocity.x = 0; }
                nPos.z += velocity.z * delta; if(checkCollisions(nPos)) { nPos.z -= velocity.z * delta; velocity.z = 0; }
                nPos.y += velocity.y * delta; 
                
                let moduloX = ((nPos.x % BLOCK_SIZE) + BLOCK_SIZE) % BLOCK_SIZE;
                let moduloZ = ((nPos.z % BLOCK_SIZE) + BLOCK_SIZE) % BLOCK_SIZE;
                let onSidewalk = (moduloX > ROAD_WIDTH/2 && moduloX < BLOCK_SIZE - ROAD_WIDTH/2) && (moduloZ > ROAD_WIDTH/2 && moduloZ < BLOCK_SIZE - ROAD_WIDTH/2);
                let currentGroundY = onSidewalk ? 0.3 : 0; 
                
                if(nPos.y < currentGroundY) { nPos.y = currentGroundY; velocity.y = 0; onGround = true; } else if (nPos.y > currentGroundY + 0.1) { onGround = false; }
                player.position.copy(nPos);

                closestInteractable = null; let minDist = 4;
                cars.forEach(car => { let d = player.position.distanceTo(car.mesh.position); if (d < minDist) { minDist = d; closestInteractable = car; } });
                groundItems.forEach(item => { let d = player.position.distanceTo(item.mesh.position); if (d < minDist) { minDist = d; closestInteractable = item; } });
                
                const prompt = document.getElementById('interaction-prompt');
                if (closestInteractable) { 
                    prompt.style.display = 'block'; 
                    if (closestInteractable.type === 'weapon') { prompt.innerText = `[F] RECOGER ${closestInteractable.name} ($${closestInteractable.price})`; prompt.style.color = playerMoney >= closestInteractable.price ? '#16a34a' : '#ef4444'; } 
                    else if (closestInteractable.isForSale) { prompt.innerText = `[F] COMPRAR VEHÍCULO ($${closestInteractable.price})`; prompt.style.color = playerMoney >= closestInteractable.price ? '#16a34a' : '#ef4444'; } 
                    else { prompt.innerText = "PULSA 'F' PARA ENTRAR AL VEHÍCULO"; prompt.style.color = '#333'; }
                } else { prompt.style.display = 'none'; }

            } else if (currentVehicle) {
                let engineForce = 0; let isBraking = false;
                if (iZ > 0) engineForce = currentVehicle.physics.accel; 
                if (iZ < 0) { if (currentVehicle.speed > 1.5) isBraking = true; else engineForce = -currentVehicle.physics.accel * 0.8; }
                if (!isBraking && engineForce === 0) { currentVehicle.speed -= Math.sign(currentVehicle.speed) * 8.0 * delta; if (Math.abs(currentVehicle.speed) < 0.5) currentVehicle.speed = 0; }
                if (isBraking) { 
                    currentVehicle.speed -= Math.sign(currentVehicle.speed) * currentVehicle.physics.brake * delta; 
                    if (Math.abs(currentVehicle.speed) < 1) currentVehicle.speed = 0; 
                    if(currentVehicle.tailLightMat) currentVehicle.tailLightMat.emissiveIntensity = 8.0; 
                } else { 
                    currentVehicle.speed += engineForce * delta; 
                    if(currentVehicle.tailLightMat) currentVehicle.tailLightMat.emissiveIntensity = 2.0; 
                }
                currentVehicle.speed -= Math.sign(currentVehicle.speed) * 0.015 * (currentVehicle.speed * currentVehicle.speed) * delta;
                currentVehicle.speed = Math.max(-currentVehicle.physics.maxSpeed/2, Math.min(currentVehicle.physics.maxSpeed, currentVehicle.speed));

                let steer = 0;
                if (Math.abs(currentVehicle.speed) > 0.1) { 
                    if (iX > 0) steer = -1; if (iX < 0) steer = 1;  
                    let speedFactor = Math.max(0.4, 1.2 - (Math.abs(currentVehicle.speed) / currentVehicle.physics.maxSpeed));
                    currentVehicle.heading += steer * currentVehicle.physics.handling * speedFactor * (currentVehicle.speed > 0 ? 1 : -1) * delta;
                    currentVehicle.mesh.rotation.y = currentVehicle.heading;
                }

                let moveX = Math.cos(currentVehicle.heading) * currentVehicle.speed * delta; let moveZ = -Math.sin(currentVehicle.heading) * currentVehicle.speed * delta;
                let nextPos = currentVehicle.mesh.position.clone(); nextPos.x += moveX; nextPos.z += moveZ;
                let carBox = new THREE.Box3().setFromObject(currentVehicle.mesh); carBox.translate(new THREE.Vector3(moveX, 0, moveZ));
                if (checkCarCollisions(carBox)) {
                    let boxX = new THREE.Box3().setFromObject(currentVehicle.mesh); boxX.translate(new THREE.Vector3(moveX, 0, 0)); let canMoveX = !checkCarCollisions(boxX);
                    let boxZ = new THREE.Box3().setFromObject(currentVehicle.mesh); boxZ.translate(new THREE.Vector3(0, 0, moveZ)); let canMoveZ = !checkCarCollisions(boxZ);
                    if (canMoveX && !canMoveZ) { nextPos.z -= moveZ; currentVehicle.speed *= 0.8; } else if (!canMoveX && canMoveZ) { nextPos.x -= moveX; currentVehicle.speed *= 0.8; } else { currentVehicle.speed = 0; nextPos.copy(currentVehicle.mesh.position); }
                } else { currentVehicle.mesh.position.copy(nextPos); }

                currentVehicle.wheels.forEach(w => w.rotation.y += currentVehicle.speed * delta * 0.5); player.position.copy(currentVehicle.mesh.position);
                
                // Efectos de velocidad
                let absSpeed = Math.abs(currentVehicle.speed);
                document.getElementById('speed-txt').innerText = Math.floor(absSpeed * 3.6);
                document.getElementById('speed-bar-fill').style.width = `${Math.min(absSpeed * 2, 100)}%`;
                
                if (absSpeed > 20) {
                    camShake = (absSpeed - 20) * 0.01;
                }
            }
            
            // Mostrar/Ocultar velocímetro
            document.getElementById('speedometer').style.display = inVehicle ? 'flex' : 'none';

            let targetCamPos = new THREE.Vector3(); let targetLookAt = new THREE.Vector3();
            if (inVehicle && currentVehicle) {
                if (isFirstPerson) {
                    const forward = new THREE.Vector3(Math.cos(currentVehicle.heading), 0, -Math.sin(currentVehicle.heading)); const right = new THREE.Vector3(Math.sin(currentVehicle.heading), 0, Math.cos(currentVehicle.heading));
                    targetCamPos.copy(currentVehicle.mesh.position); targetCamPos.y += 1.0; targetCamPos.add(forward.clone().multiplyScalar(0.2)); targetCamPos.add(right.clone().multiplyScalar(-0.4)); 
                    targetLookAt.copy(targetCamPos).add(new THREE.Vector3(Math.sin(cameraAngles.theta) * Math.sin(cameraAngles.phi), Math.cos(cameraAngles.phi), Math.cos(cameraAngles.theta) * Math.sin(cameraAngles.phi)));
                    currentCamPos.copy(targetCamPos); currentLookAt.copy(targetLookAt);
                } else {
                    const camDist = 10; const camHeight = 4;
                    targetCamPos.set(currentVehicle.mesh.position.x - Math.cos(currentVehicle.heading) * camDist, currentVehicle.mesh.position.y + camHeight, currentVehicle.mesh.position.z + Math.sin(currentVehicle.heading) * camDist);
                    targetLookAt.copy(currentVehicle.mesh.position).add(new THREE.Vector3(0, 1.5, 0));
                }
            } else if (isFirstPerson) {
                const camForward = new THREE.Vector3(0, 0, 1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotation.y);
                targetCamPos.copy(playerRig.head.getWorldPosition(new THREE.Vector3())); targetCamPos.y += 0.1; targetCamPos.add(camForward.multiplyScalar(0.2)); 
                targetLookAt.copy(targetCamPos).add(new THREE.Vector3(Math.sin(cameraAngles.theta) * Math.sin(cameraAngles.phi), Math.cos(cameraAngles.phi), Math.cos(cameraAngles.theta) * Math.sin(cameraAngles.phi)));
                currentCamPos.copy(targetCamPos); currentLookAt.copy(targetLookAt);
            } else {
                targetCamPos.set(player.position.x + cameraRadius * Math.sin(cameraAngles.phi) * Math.sin(cameraAngles.theta), player.position.y + 2.5 + cameraRadius * Math.cos(cameraAngles.phi), player.position.z + cameraRadius * Math.sin(cameraAngles.phi) * Math.cos(cameraAngles.theta));
                targetLookAt.set(player.position.x, player.position.y + 1.2, player.position.z);
            }

            if (!isFirstPerson) { currentCamPos.lerp(targetCamPos, 0.1); currentLookAt.lerp(targetLookAt, 0.15); }
            
            // Aplicar Camera Shake
            if (camShake > 0.01) {
                currentCamPos.x += (Math.random()-0.5) * camShake;
                currentCamPos.y += (Math.random()-0.5) * camShake;
                camShake *= 0.9;
            }

            camera.position.copy(currentCamPos); camera.lookAt(currentLookAt);

            if (water) water.material.uniforms[ 'time' ].value += 1.0 / 60.0;
            updateNPCs(delta);

            if (composer) composer.render(); else renderer.render(scene, camera);
        }

        init();
        animate();
    </script>
</body>
