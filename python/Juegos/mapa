<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Metrópolis - Inventario y Personaje</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Three.js y GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    
    <!-- Post-processing -->
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/postprocessing/UnrealBloomPass.js"></script>
    
    <!-- Water -->
    <script src="https://cdn.jsdelivr.net/gh/mrdoob/three.js@r128/examples/js/objects/Water.js"></script>

    <style>
        body { margin: 0; overflow: hidden; background-color: #87CEEB; font-family: 'Inter', sans-serif; touch-action: none; }
        #gameCanvas { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; display: block; z-index: 1; }
        #ui-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; z-index: 10; box-shadow: inset 0 0 150px rgba(0,0,0,0.5); }
        .hud-element { pointer-events: auto; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.15); color: white; box-shadow: 0 8px 32px rgba(0,0,0,0.4); border-radius: 16px; }
        #crosshair { position: absolute; top: 50%; left: 50%; width: 4px; height: 4px; background: rgba(255,255,255,0.9); border-radius: 50%; transform: translate(-50%, -50%); opacity: 0; pointer-events: none; transition: opacity 0.3s; z-index: 10; box-shadow: 0 0 4px black;}
        
        /* Speedometer */
        #speedometer { position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); display: none; flex-direction: column; align-items: center; gap: 4px; z-index: 15; }
        .speed-val { font-size: 3rem; font-weight: 900; color: white; text-shadow: 0 0 10px rgba(56, 189, 248, 0.5); font-family: 'Inter', sans-serif; line-height: 1; }
        .speed-unit { font-size: 0.8rem; color: #38bdf8; font-weight: bold; letter-spacing: 0.1em; }
        .speed-bar-container { width: 120px; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; margin-top: 8px; }
        #speed-bar-fill { width: 0%; height: 100%; background: #38bdf8; transition: width 0.1s; box-shadow: 0 0 8px #38bdf8; }
        
        /* PANTALLA DE CARGA / INICIO */
        #start-screen { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #0f172a; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: auto; z-index: 50; transition: opacity 1.0s ease; background-image: radial-gradient(circle at center, #1e293b 0%, #020617 100%); }
        
        /* Mapas */
        #minimap-container { position: absolute; top: 20px; right: 20px; width: 220px; height: 220px; border-radius: 50%; overflow: hidden; border: 4px solid #0f172a; box-shadow: 0 0 0 2px rgba(56,189,248,0.5), 0 10px 30px rgba(0,0,0,0.5); pointer-events: auto; cursor: pointer; background: #cbd5e1; z-index: 20; transition: transform 0.2s;}
        #minimap-container::after { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: repeating-linear-gradient(0deg, rgba(255,255,255,0.03), rgba(255,255,255,0.03) 1px, transparent 1px, transparent 4px); pointer-events: none; border-radius: 50%; }
        #minimap-container:hover { transform: scale(1.05); }
        #minimap-canvas { width: 100%; height: 100%; }
        
        #fullscreen-map-overlay { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(2, 6, 23, 0.95); backdrop-filter: blur(15px); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 40; pointer-events: auto; }
        #fullscreen-map-canvas { width: 90vw; height: 80vh; max-width: 1200px; border-radius: 12px; box-shadow: 0 0 0 4px #0f172a, 0 0 0 6px rgba(56,189,248,0.5), 0 20px 60px rgba(0,0,0,0.8); cursor: grab; }
        #fullscreen-map-canvas:active { cursor: grabbing; }

        /* Pantalla de Inventario */
        #inventory-overlay { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.90); backdrop-filter: blur(8px); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 45; pointer-events: auto; }
        .inv-slot { width: 100px; height: 100px; background: rgba(30, 41, 59, 0.8); border: 2px solid rgba(71, 85, 105, 0.5); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: all 0.2s; box-shadow: inset 0 0 20px rgba(0,0,0,0.5); }
        .inv-slot.has-item { border-color: rgba(56, 189, 248, 0.6); cursor: pointer; }
        .inv-slot.has-item:hover { background: rgba(51, 65, 85, 0.9); transform: scale(1.05); box-shadow: 0 0 15px rgba(56, 189, 248, 0.4); }
        .inv-slot.active-item { border-color: #22c55e; background: rgba(20, 83, 45, 0.4); box-shadow: 0 0 20px rgba(34, 197, 94, 0.4); }
        
        /* Controles y HUD */
        #player-stats { position: absolute; top: 24px; left: 24px; display: flex; flex-direction: column; gap: 8px; pointer-events: none; z-index: 15; }
        .stat-bar-container { width: 200px; background: rgba(15, 23, 42, 0.8); padding: 8px 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; backdrop-filter: blur(4px); box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        .stat-bar-bg { flex-grow: 1; height: 10px; background: #1e293b; border-radius: 5px; overflow: hidden; box-shadow: inset 0 2px 4px rgba(0,0,0,0.5); }
        
        #joystick-zone { position: absolute; bottom: 40px; left: 40px; width: 130px; height: 130px; background: rgba(0,0,0,0.05); border: 2px solid rgba(0,0,0,0.1); border-radius: 50%; pointer-events: auto; display: none; touch-action: none; }
        #joystick-knob { position: absolute; top: 40px; left: 40px; width: 50px; height: 50px; background: rgba(0,0,0,0.3); border-radius: 50%; pointer-events: none; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        
        .action-btn { position: absolute; border-radius: 50%; display: none; pointer-events: auto; user-select: none; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(4px); font-weight: bold; background: rgba(30, 41, 59, 0.8); color: white; }
        #jump-btn { bottom: 60px; right: 50px; width: 70px; height: 70px; font-size: 14px; }
        #cam-btn { bottom: 150px; right: 60px; width: 50px; height: 50px; font-size: 20px; }
        #weapon-btn { bottom: 220px; right: 60px; width: 50px; height: 50px; font-size: 20px; background: rgba(255, 255, 255, 0.9); color: #333; }
        #interact-btn { bottom: 290px; right: 60px; width: 50px; height: 50px; background: rgba(250, 204, 21, 0.9); color: #333; font-size: 20px; }
        #inv-btn { bottom: 360px; right: 60px; width: 50px; height: 50px; font-size: 20px; background: rgba(56, 189, 248, 0.8); color: white; }
        #fire-btn { bottom: 60px; right: 140px; width: 70px; height: 70px; background: rgba(239, 68, 68, 0.9); color: white; font-size: 24px; display: none; }
        
        #weapon-hud { position: absolute; bottom: 30px; right: 140px; pointer-events: none; display: flex; align-items: center; gap: 15px; transition: transform 0.2s; }
        #money-hud { position: absolute; top: 30px; right: 260px; pointer-events: none; display: flex; align-items: center; gap: 10px; font-size: 1.5rem; font-family: monospace; font-weight: bold; color: #4ade80; background: rgba(15, 23, 42, 0.9); padding: 10px 20px; border-radius: 12px; border: 1px solid rgba(0,0,0,0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.2); z-index: 15;}
        #notification-toast { position: absolute; top: 90px; right: 260px; background: rgba(15, 23, 42, 0.95); color: white; padding: 10px 20px; border-radius: 8px; font-weight: bold; opacity: 0; transition: opacity 0.3s; pointer-events: none; z-index: 15; box-shadow: 0 4px 10px rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); }
        #gps-distance-hud { position: absolute; top: 120px; left: 50%; transform: translateX(-50%); pointer-events: none; display: none; align-items: center; gap: 10px; background: rgba(15, 23, 42, 0.9); border: 2px solid #ef4444; padding: 8px 20px; border-radius: 30px; color: #ef4444; font-weight: bold; font-family: monospace; font-size: 1.2rem; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2); }
        #interaction-prompt { position: absolute; top: 60%; left: 50%; transform: translateX(-50%); background: rgba(255,255,255,0.98); border: 1px solid rgba(0,0,0,0.1); color: #0f172a; padding: 12px 24px; border-radius: 8px; font-weight: 900; font-size: 1.2rem; pointer-events: none; display: none; z-index: 15; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }

        @media (max-width: 768px) {
            #joystick-zone, .action-btn { display: flex; }
            #instructions-pc { display: none; }
            #weapon-hud { right: auto; left: 50%; bottom: 20px; transform: translateX(-50%); }
            #minimap-container { width: 140px; height: 140px; top: 10px; right: 10px; border-width: 2px; }
            #money-hud { right: 160px; top: 10px; font-size: 1.1rem; padding: 5px 10px; }
            #notification-toast { right: 160px; top: 60px; font-size: 0.8rem; }
            #player-stats { top: 10px; left: 10px; }
            .stat-bar-container { width: 140px; padding: 4px 8px; }
            #inventory-overlay .grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }
            .inv-slot { width: 80px; height: 80px; }
        }
    </style>
</head>
<body>

    <canvas id="gameCanvas"></canvas>
    <div id="crosshair"></div>

    <div id="ui-layer" class="p-6 z-10">
        
        <!-- HUD Estado Jugador -->
        <div id="player-stats">
            <div class="stat-bar-container">
                <span class="text-green-400 font-bold text-lg leading-none">♥</span>
                <div class="stat-bar-bg"><div class="bg-gradient-to-r from-green-600 to-green-400 h-full w-[100%] shadow-[0_0_8px_#22c55e]"></div></div>
            </div>
            <div class="stat-bar-container">
                <span class="text-blue-400 font-bold text-lg leading-none">🛡</span>
                <div class="stat-bar-bg"><div class="bg-gradient-to-r from-blue-600 to-blue-400 h-full w-[50%] shadow-[0_0_8px_#3b82f6]"></div></div>
            </div>
        </div>

        <div class="hud-element p-5 rounded-2xl max-w-sm mt-20" id="instructions-pc">
            <div class="flex items-center justify-between mb-2">
                <h1 class="text-xl font-black tracking-tight text-white">METRÓPOLIS</h1>
                <span class="px-2 py-1 text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 rounded">CHARACTER UPDATE</span>
            </div>
            <p class="text-xs text-slate-400 mb-4">Modelo detallado, animaciones procedurales e inventario táctico.</p>
            <div class="space-y-2 text-sm text-slate-300 font-medium">
                <div class="flex justify-between"><span class="font-bold text-white">CLICK</span> <span>Bloquear Ratón / Disparar</span></div>
                <div class="flex justify-between"><span class="font-bold text-white">W A S D</span> <span>Moverse / Conducir</span></div>
                <div class="flex justify-between"><span class="font-bold text-white">SHIFT</span> <span>Correr rápido</span></div>
                <div class="flex justify-between"><span class="font-bold text-yellow-400">TECLA F</span> <span class="text-yellow-400">Interactuar</span></div>
                <div class="flex justify-between"><span class="font-bold text-sky-400">TECLA TAB</span> <span class="text-sky-400">Abrir Inventario</span></div>
                <div class="flex justify-between"><span class="font-bold text-blue-400">TECLA M</span> <span class="text-blue-400">Mapa GPS</span></div>
            </div>
        </div>

        <div id="joystick-zone"><div id="joystick-knob"></div></div>
        <button id="jump-btn" class="action-btn">⬆</button>
        <button id="fire-btn" class="action-btn">🔥</button>
        <button id="cam-btn" class="action-btn">👁️</button>
        <button id="weapon-btn" class="action-btn">🔫</button>
        <button id="interact-btn" class="action-btn">🚗</button>
        <button id="inv-btn" class="action-btn">🎒</button>
        
        <div id="interaction-prompt">PULSA 'F' PARA INTERACTUAR</div>

        <div id="weapon-hud" class="hud-element px-6 py-3 rounded-full font-mono">
            <span class="text-slate-400 mr-2 text-xl" id="weapon-icon">👊</span> 
            <span id="weapon-name" class="font-bold tracking-widest text-sm text-white">DESARMADO</span>
        </div>

        <div id="money-hud"><span>$</span><span id="money-val">50000</span></div>
        <div id="notification-toast">NOTIFICACIÓN</div>

        <!-- Velocímetro -->
        <div id="speedometer">
            <div class="speed-val" id="speed-txt">0</div>
            <div class="speed-unit">KM/H</div>
            <div class="speed-bar-container"><div id="speed-bar-fill"></div></div>
        </div>

        <div id="minimap-container"><canvas id="minimap-canvas" width="400" height="400"></canvas></div>
        <div id="gps-distance-hud"><span>📍 DESTINO:</span> <span id="gps-dist-val">0</span><span>m</span></div>
    </div>

    <!-- Menú de Inventario Visual -->
    <div id="inventory-overlay">
        <h2 class="text-4xl font-black text-white mb-8 tracking-widest drop-shadow-[0_0_15px_rgba(56,189,248,0.5)]">INVENTARIO TÁCTICO</h2>
        <div class="grid grid-cols-4 gap-4" id="inventory-grid">
            <!-- Slots generados dinámicamente -->
        </div>
        <p class="text-slate-400 mt-10 font-medium bg-black/50 px-6 py-2 rounded-full border border-white/10">Pulsa 'TAB' o la 'X' para cerrar y volver a la ciudad.</p>
        <button onclick="toggleInventory()" class="mt-4 px-6 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-full font-bold transition-colors">CERRAR (X)</button>
    </div>

    <div id="fullscreen-map-overlay">
        <h2 class="text-2xl font-black text-sky-400 mb-4 tracking-widest bg-slate-900 px-8 py-3 rounded-full border border-sky-500/30 shadow-[0_0_20px_rgba(56,189,248,0.2)]">SISTEMA CARTOGRÁFICO</h2>
        <canvas id="fullscreen-map-canvas"></canvas>
        <p class="text-slate-300 mt-4 font-medium bg-slate-900/80 px-6 py-2 rounded-full border border-slate-700">Arrastra para moverte. Rueda del ratón para zoom. Clic derecho para marcar ruta.</p>
        <button id="close-map-btn" class="mt-4 px-8 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-full transition-colors shadow-[0_0_15px_rgba(220,38,38,0.4)] border border-red-400">CERRAR MAPA</button>
    </div>

    <div id="start-screen">
        <h1 class="text-5xl md:text-8xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-400 mb-8 tracking-tighter drop-shadow-2xl">METRÓPOLIS</h1>
        <button id="btn-start" class="px-12 py-5 bg-sky-500 hover:bg-sky-400 text-white rounded-full overflow-hidden transition-all duration-300 shadow-[0_0_30px_rgba(56,189,248,0.4)] hover:shadow-[0_0_50px_rgba(56,189,248,0.8)] font-black tracking-widest text-lg border border-sky-300">
            ENTRAR AL MUNDO
        </button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        let width = window.innerWidth; let height = window.innerHeight;

        const CITY_SIZE = 2400; 
        const BLOCK_SIZE = 240; 
        const ROAD_WIDTH = 24; 
        const HALF_CITY = CITY_SIZE / 2;
        
        const CARTEL_X = 720; const CARTEL_Z = -720;
        const DEALER_X = -240; const DEALER_Z = -240; 
        const ARMORY_X = -240; const ARMORY_Z = 240;  
        
        let playerMoney = 50000;
        let groundItems = []; 
        let closestInteractable = null;
        
        // --- SISTEMA DE INVENTARIO ---
        const maxSlots = 8;
        let inventory = [
            { id: 'none', name: 'DESARMADO', icon: '👊', type: 'weapon' }
        ];
        let isInventoryOpen = false;
        
        let scene, camera, renderer;
        let buildings = []; let cars = []; let sidewalks = []; let streetProps = [];
        let envMap; 
        
        let player, playerRig = {};
        let isLocked = false; let isFirstPerson = false;
        let isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        
        const keys = { w: false, a: false, s: false, d: false, space: false, shift: false, m: false, f: false };
        const joystick = { x: 0, y: 0, active: false };
        let activeWeapon = 'none';

        let cameraAngles = { theta: Math.PI, phi: Math.PI * 0.4 };
        let cameraRadius = 5; let currentCamPos = new THREE.Vector3(); let currentLookAt = new THREE.Vector3();
        
        let velocity = new THREE.Vector3(); let direction = new THREE.Vector3();
        let onGround = true; const gravity = -30.0; const jumpVelocity = 12.0; let moveSpeed = 5.0; 
        const clock = new THREE.Clock(); let walkCycle = 0; let runCycle = 0;
        
        let isMapOpen = false; let waypoint = null; let gpsBeaconLine = null; let gpsBeaconBeam = null;
        let mapCam = { x: 0, z: 0, zoom: 1 };
        let mapDrag = { active: false, startX: 0, startY: 0, initCamX: 0, initCamZ: 0 };
        
        let inVehicle = false; let currentVehicle = null; let interactCooldown = 0; let globalHeadlights;

        let isShooting = false; let lastShootTime = 0; let tracers = []; let impactParticles = [];
        let muzzleFlash; let audioCtx = null;
        const weaponsData = { 'pistol': { rate: 0.3, auto: false, color: 0xffcc88 }, 'uzi': { rate: 0.08, auto: true, color: 0xffaa00 }, 'ak': { rate: 0.15, auto: true, color: 0xffaa00 } };

        let composer, bloomPass, water;
        let npcInstances, npcArmL, npcArmR, npcLegL, npcLegR, npcHead;
        let npcs = []; const MAX_NPCS = 150;
        let camShake = 0;

        function showToast(msg, color = '#ef4444') {
            const toast = document.getElementById('notification-toast'); toast.innerText = msg;
            toast.style.backgroundColor = color === '#ef4444' ? 'rgba(239, 68, 68, 0.95)' : 'rgba(34, 197, 94, 0.95)';
            toast.style.opacity = '1'; setTimeout(() => toast.style.opacity = '0', 2500);
        }

        // GUI de Inventario
        function toggleInventory() {
            isInventoryOpen = !isInventoryOpen;
            const overlay = document.getElementById('inventory-overlay');
            if (isInventoryOpen) {
                if (document.pointerLockElement) document.exitPointerLock();
                overlay.style.display = 'flex';
                renderInventory();
            } else {
                overlay.style.display = 'none';
                if (!isMobile && !isMapOpen) document.body.requestPointerLock();
            }
        }

        function renderInventory() {
            const grid = document.getElementById('inventory-grid');
            grid.innerHTML = '';
            for(let i=0; i<maxSlots; i++) {
                const item = inventory[i];
                const slot = document.createElement('div');
                
                if (item) {
                    const isActive = item.id === activeWeapon;
                    slot.className = `inv-slot has-item ${isActive ? 'active-item' : ''}`;
                    slot.innerHTML = `<span class="text-4xl mb-2 drop-shadow-md">${item.icon}</span><span class="text-xs font-bold text-center tracking-widest">${item.name}</span>`;
                    slot.onclick = () => {
                        if (item.type === 'weapon') {
                            equipWeapon(item.id);
                            renderInventory(); // Re-render to show active
                        }
                    };
                } else {
                    slot.className = 'inv-slot';
                    slot.innerHTML = `<span class="text-slate-600 text-sm font-bold">VACÍO</span>`;
                }
                grid.appendChild(slot);
            }
        }

        function playGunSound(type) {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const bufferSize = audioCtx.sampleRate * 0.2; const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0); for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
            const noise = audioCtx.createBufferSource(); noise.buffer = buffer;
            const filter = audioCtx.createBiquadFilter(); filter.type = 'lowpass'; const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(type === 'ak' ? 0.8 : 0.5, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + (type === 'uzi' ? 0.05 : 0.1));
            if (type === 'pistol') filter.frequency.value = 1200; if (type === 'uzi') filter.frequency.value = 2500; if (type === 'ak') filter.frequency.value = 800;
            noise.connect(filter); filter.connect(gain); gain.connect(audioCtx.destination); noise.start();
        }

        function createTracer(start, end, color) {
            const mat = new THREE.LineBasicMaterial({ color: color, transparent: true, opacity: 0.8 });
            const geo = new THREE.BufferGeometry().setFromPoints([start, end]);
            const line = new THREE.Line(geo, mat); scene.add(line); tracers.push({ mesh: line, life: 1.0 });
        }

        function createImpact(pos, normal) {
            const geo = new THREE.BoxGeometry(0.1, 0.1, 0.1); const mat = new THREE.MeshBasicMaterial({ color: 0xaaaaaa });
            for (let i = 0; i < 4; i++) {
                const p = new THREE.Mesh(geo, mat); p.position.copy(pos);
                const vel = normal.clone().add(new THREE.Vector3((Math.random()-0.5)*2, (Math.random()-0.5)*2, (Math.random()-0.5)*2)).normalize().multiplyScalar(Math.random() * 5 + 5);
                scene.add(p); impactParticles.push({ mesh: p, velocity: vel, life: 1.0 });
            }
        }

        function shootWeapon() {
            if (activeWeapon === 'none' || inVehicle || isMapOpen || isInventoryOpen) return;
            const now = clock.getElapsedTime(); const stats = weaponsData[activeWeapon];
            if (now - lastShootTime < stats.rate) return; lastShootTime = now;
            
            playGunSound(activeWeapon);
            muzzleFlash.color.setHex(stats.color); muzzleFlash.intensity = 2.0; 
            
            const camDir = new THREE.Vector3(); camera.getWorldDirection(camDir);
            const spawnPos = new THREE.Vector3();
            if (isFirstPerson) {
                spawnPos.copy(camera.position).add(camDir.clone().multiplyScalar(0.5));
                const right = new THREE.Vector3().crossVectors(camera.up, camDir).normalize(); spawnPos.add(right.multiplyScalar(0.2)).y -= 0.2;
            } else {
                spawnPos.copy(player.position); spawnPos.y += 1.3; spawnPos.add(camDir.clone().multiplyScalar(0.5));
            }
            muzzleFlash.position.copy(spawnPos);
            
            const raycaster = new THREE.Raycaster(); raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
            const intersects = raycaster.intersectObjects(scene.children, true).filter(hit => 
                hit.object.visible && hit.object !== playerRig.torso && hit.object !== playerRig.head &&
                hit.object !== playerRig.armL && hit.object !== playerRig.armR && hit.object !== playerRig.legL && hit.object !== playerRig.legR &&
                !hit.object.geometry.type.includes('Dashed') && hit.object !== muzzleFlash
            );
            
            let endPos = new THREE.Vector3().copy(camera.position).add(camDir.clone().multiplyScalar(300));
            if (intersects.length > 0) { endPos.copy(intersects[0].point); createImpact(endPos, intersects[0].face ? intersects[0].face.normal : new THREE.Vector3(0,1,0)); }
            
            createTracer(spawnPos, endPos, stats.color); cameraAngles.phi -= (activeWeapon === 'ak' ? 0.02 : 0.01);
            if (!stats.auto) isShooting = false;
        }

        function generatePBRTextures() {
            const roadCnv = document.createElement('canvas'); roadCnv.width = 512; roadCnv.height = 512; const rctx = roadCnv.getContext('2d');
            rctx.fillStyle = '#222222'; rctx.fillRect(0, 0, 512, 512); 
            for(let i=0; i<3000; i++) { rctx.fillStyle = Math.random() > 0.5 ? '#1a1a1a' : '#2a2a2a'; rctx.fillRect(Math.random()*512, Math.random()*512, 3, 3); }
            rctx.fillStyle = '#dddddd'; for(let i=0; i<512; i+=60) rctx.fillRect(250, i + 10, 6, 30); 
            const roadDiffuse = new THREE.CanvasTexture(roadCnv); roadDiffuse.wrapS = THREE.RepeatWrapping; roadDiffuse.wrapT = THREE.RepeatWrapping; roadDiffuse.anisotropy = 2;

            const normCnv = document.createElement('canvas'); normCnv.width = 256; normCnv.height = 256; const nctx = normCnv.getContext('2d');
            nctx.fillStyle = '#8080ff'; nctx.fillRect(0,0,256,256); 
            for(let i=0; i<2000; i++) {
                let r = 128 + (Math.random()*40-20); let g = 128 + (Math.random()*40-20);
                nctx.fillStyle = `rgb(${r},${g},255)`; nctx.fillRect(Math.random()*256, Math.random()*256, 2, 2);
            }
            const asphaltNormalMap = new THREE.CanvasTexture(normCnv); asphaltNormalMap.wrapS = asphaltNormalMap.wrapT = THREE.RepeatWrapping;

            const commPalettes = [{ wall: '#cbd5e1', win: '#020617' }, { wall: '#94a3b8', win: '#0f172a' }]; 
            const resPalettes = [{ wall: '#b45309', win: '#1e293b' }, { wall: '#d97706', win: '#334155' }, { wall: '#e2e8f0', win: '#475569' }]; 
            const indPalettes = [{ wall: '#64748b', win: '#0f172a' }, { wall: '#475569', win: '#1e293b' }]; 

            const generateMats = (palettes) => palettes.map(pal => {
                const difCnv = document.createElement('canvas'); difCnv.width = 512; difCnv.height = 512; const dctx = difCnv.getContext('2d');
                const emCnv = document.createElement('canvas'); emCnv.width = 512; emCnv.height = 512; const ectx = emCnv.getContext('2d');
                
                dctx.fillStyle = pal.wall; dctx.fillRect(0,0,512,512);
                ectx.fillStyle = '#000000'; ectx.fillRect(0,0,512,512);

                for(let i=0; i<1500; i++) { dctx.fillStyle = 'rgba(0,0,0,0.03)'; dctx.fillRect(Math.random()*512, Math.random()*512, 4, 4); }
                
                const rows = 12, cols = 8; const winW = 512/cols * 0.75; const winH = 512/rows * 0.75; const padX = (512/cols - winW) / 2; const padY = (512/rows - winH) / 2;
                
                for(let r=0; r<rows; r++) { 
                    for(let c=0; c<cols; c++) { 
                        const x = c * (512/cols) + padX; const y = r * (512/rows) + padY; 
                        dctx.fillStyle = pal.win; dctx.fillRect(x, y, winW, winH);
                        // Random emissive windows for night look
                        if (Math.random() > 0.6) {
                            ectx.fillStyle = Math.random() > 0.5 ? '#fffacd' : '#ffffff';
                            ectx.fillRect(x, y, winW, winH);
                        }
                    } 
                }
                
                const map = new THREE.CanvasTexture(difCnv); map.wrapS = map.wrapT = THREE.RepeatWrapping; map.anisotropy = 4;
                const emMap = new THREE.CanvasTexture(emCnv); emMap.wrapS = emMap.wrapT = THREE.RepeatWrapping;
                
                return new THREE.MeshStandardMaterial({ 
                    map: map, 
                    emissiveMap: emMap, 
                    emissive: new THREE.Color(0xffffff),
                    emissiveIntensity: 0.5,
                    roughness: 0.7, 
                    metalness: 0.2 
                }); 
            });

            const sideCnv = document.createElement('canvas'); sideCnv.width = 256; sideCnv.height = 256; const sctx = sideCnv.getContext('2d');
            sctx.fillStyle = '#9ca3af'; sctx.fillRect(0,0,256,256); sctx.strokeStyle = '#64748b'; sctx.lineWidth = 4; sctx.strokeRect(0,0,256,256);
            for(let i=1; i<4; i++){ sctx.beginPath(); sctx.moveTo(i*64, 0); sctx.lineTo(i*64, 256); sctx.stroke(); sctx.beginPath(); sctx.moveTo(0, i*64); sctx.lineTo(256, i*64); sctx.stroke(); }
            const sideDiffuse = new THREE.CanvasTexture(sideCnv); sideDiffuse.wrapS = THREE.RepeatWrapping; sideDiffuse.wrapT = THREE.RepeatWrapping;

            return { roadDiffuse, commMats: generateMats(commPalettes), resMats: generateMats(resPalettes), indMats: generateMats(indPalettes), sideDiffuse, asphaltNormalMap };
        }

        // Helper para ajustar UVs de la geometría para evitar clonar materiales
        function scaleUVs(geometry, sx, sy) {
            const uv = geometry.attributes.uv;
            for (let i = 0; i < uv.count; i++) {
                uv.setXY(i, uv.getX(i) * sx, uv.getY(i) * sy);
            }
            uv.needsUpdate = true;
        }

        function createTextSign(text, mainColor, bgColor) {
            const canvas = document.createElement('canvas'); canvas.width = 1024; canvas.height = 256; const ctx = canvas.getContext('2d');
            ctx.fillStyle = bgColor; ctx.fillRect(0, 0, 1024, 256);
            ctx.strokeStyle = '#333'; ctx.lineWidth = 10; ctx.strokeRect(5, 5, 1014, 246);
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.font = '900 100px "Inter", sans-serif';
            ctx.fillStyle = mainColor; ctx.fillText(text, 512, 128); 
            const tex = new THREE.CanvasTexture(canvas); tex.anisotropy = 4; tex.needsUpdate = true;
            return new THREE.MeshStandardMaterial({ map: tex, roughness: 0.5, metalness: 0.1 }); 
        }

