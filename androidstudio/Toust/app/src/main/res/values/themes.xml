<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Toust" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0F1A</item>
        <item name="android:statusBarColor">#0D0F1A</item>
        <item name="android:navigationBarColor">#0D0F1A</item>
    </style>

    <!--
         LockScreenActivity extiende AppCompatActivity (necesario para BiometricPrompt).
         AppCompatActivity EXIGE un tema que herede de Theme.AppCompat.
         Este tema es completamente negro/transparente — Compose pinta todo encima.
    -->
    <style name="Theme.Toust.LockScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#060810</item>
        <item name="android:statusBarColor">#060810</item>
        <item name="android:navigationBarColor">#060810</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>