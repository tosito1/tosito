        let tempRack = [...rackLetters];
        for (let char of word) {
            let idx = tempRack.indexOf(char);
            if (idx !== -1) tempRack.splice(idx, 1);
            else {
                let blankIdx = tempRack.indexOf('');
                if (blankIdx !== -1) tempRack.splice(blankIdx, 1);
