        function generateSkyscrapers(cx, cz, size, materials, roofMat) {
            const padding = 12; 
            const parcelSize = (size / 2) - padding; 
            const offsets = [[-1, -1], [1, -1], [-1, 1], [1, 1]];

            offsets.forEach(off => {
                if (Math.random() < 0.2) return; 
                const dist = Math.sqrt(cx*cx + cz*cz); const isCenter = dist < 400;
                const maxH = isCenter ? 60 + Math.random()*120 : 15 + Math.random()*35; 
                const tiers = isCenter ? 2 + Math.floor(Math.random() * 3) : 1 + Math.floor(Math.random() * 2);
                
                const px = cx + (off[0] * (size/4 + padding/4)); 
                const pz = cz + (off[1] * (size/4 + padding/4));
                
                let currentW = parcelSize; let currentD = parcelSize; let currentY = 0.3; 
                const matBase = materials[Math.floor(Math.random() * materials.length)]; 
                const bGroup = new THREE.Group(); bGroup.position.set(px, 0, pz);

                for(let t=0; t<tiers; t++) {
                    const tierH = (maxH / tiers) * (1 - t*0.2); 
                    const geo = new THREE.BoxGeometry(currentW, tierH, currentD);
                    scaleUVs(geo, currentW/10, tierH/3); // Escalado de UVs en lugar de clonar material
                    
                    const mesh = new THREE.Mesh(geo, [matBase, matBase, roofMat, roofMat, matBase, matBase]);
                    mesh.position.y = currentY + tierH/2; mesh.castShadow = true; mesh.receiveShadow = true; bGroup.add(mesh);
                    
                    // Detalle en el techo del último nivel
                    if (t === tiers - 1) {
                        // Antenas o Helipuertos
                        if (isCenter && Math.random() > 0.7) {
                            // Helipuerto
                            const heliGeo = new THREE.CylinderGeometry(currentW*0.35, currentW*0.35, 0.2, 16);
                            const heliMat = new THREE.MeshStandardMaterial({ color: 0x333333, roughness: 0.8 });
                            const heli = new THREE.Mesh(heliGeo, heliMat);
                            heli.position.y = currentY + tierH + 0.1;
                            bGroup.add(heli);
                            // Letra H
                            const hCnv = document.createElement('canvas'); hCnv.width = 128; hCnv.height = 128; const hctx = hCnv.getContext('2d');
                            hctx.fillStyle = 'white'; hctx.font = 'bold 80px Arial'; hctx.textAlign = 'center'; hctx.textBaseline = 'middle';
                            hctx.fillText('H', 64, 64);
                            const hTex = new THREE.CanvasTexture(hCnv);
                            const hMesh = new THREE.Mesh(new THREE.PlaneGeometry(currentW*0.4, currentW*0.4), new THREE.MeshBasicMaterial({map: hTex, transparent: true}));
                            hMesh.rotation.x = -Math.PI/2; hMesh.position.y = currentY + tierH + 0.21;
                            bGroup.add(hMesh);
                        } else if (Math.random() > 0.5) {
                            // Antena
                            const antBase = new THREE.Mesh(new THREE.BoxGeometry(0.5, 1, 0.5), new THREE.MeshStandardMaterial({color: 0x222222}));
                            antBase.position.set(0, currentY + tierH + 0.5, 0);
                            const antPole = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.1, 6, 8), new THREE.MeshStandardMaterial({color: 0x444444}));
                            antPole.position.set(0, currentY + tierH + 4, 0);
                            const antTip = new THREE.PointLight(0xff0000, 1, 10); antTip.position.set(0, currentY + tierH + 7, 0);
                            bGroup.add(antBase, antPole, antTip);
                        }
                    }

                    currentY += tierH; currentW *= 0.8; currentD *= 0.8;
                }
                scene.add(bGroup); const box = new THREE.Box3().setFromObject(bGroup); buildings.push(box);
            });
        }

