        function addTree(x, y, z, scale = 1.0) {
            if (treeCount >= MAX_TREES) return;
            const dummy = new THREE.Object3D();
            dummy.position.set(x, y + 1, z);
            dummy.scale.set(scale, scale, scale);
            dummy.updateMatrix();
            treeTrunkInstances.setMatrixAt(treeCount, dummy.matrix);
            dummy.position.set(x, y + 2.5, z);
            dummy.updateMatrix();
            treeLeavesInstances.setMatrixAt(treeCount, dummy.matrix);
            treeCount++;
        }

        function addFurniture(x, y, z, type, rot = 0) {
            if (benchCount >= MAX_FURNITURE || trashCount >= MAX_FURNITURE) return;
            const dummy = new THREE.Object3D();
            dummy.position.set(x, y, z);
            dummy.rotation.y = rot;
            dummy.updateMatrix();
            if (type === 'bench') { benchInstances.setMatrixAt(benchCount++, dummy.matrix); }
            else if (type === 'trash') { trashInstances.setMatrixAt(trashCount++, dummy.matrix); }
        }

