<Window x:Class="OptimizadorInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador Tosito Optimizer V2" Height="450" Width="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseDown="Window_MouseDown">
    
    <Window.Resources>
        <!-- Paleta Catppuccin Mocha -->
        <SolidColorBrush x:Key="BgDark" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="Accent" Color="#89B4FA"/>
        <SolidColorBrush x:Key="TextMain" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSub" Color="#A6ADC8"/>
        
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F38BA8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstallButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="12" Padding="30,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#89B4FA" Offset="0"/>
                                    <GradientStop Color="#CBA6F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="20" BorderBrush="#313244" BorderThickness="1">
        <Grid>
            <!-- Background Decorative Blur/Circles -->
            <Ellipse Fill="#89B4FA" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0" Opacity="0.05">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Fill="#CBA6F7" Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100" Opacity="0.05">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Content -->
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="0">
                    <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click" FontSize="18"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Tosito Optimizer V2" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Estás a un paso de tener un PC súper rápido" FontSize="16" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,5,0,30"/>
                    
                    <Grid Width="500">
                        <StackPanel x:Name="InitialControls">
                            <Button x:Name="BtnInstall" Content="INSTALAR AHORA" Style="{StaticResource InstallButtonStyle}" Click="BtnInstall_Click"/>
                            <CheckBox x:Name="ChkShortcut" Content="Crear acceso directo en el escritorio" 
                                      Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" 
                                      IsChecked="True" Margin="0,20,0,0" FontSize="14" Cursor="Hand"/>
                        </StackPanel>
                        
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                            <TextBlock x:Name="StatusText" Text="Preparando archivos..." Foreground="{StaticResource TextMain}" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="InstallProgress" Height="10" Value="0" Background="#313244" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#89B4FA" Offset="0"/>
                                        <GradientStop Color="#CBA6F7" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2" Text="© 2026 Tosito Dev - Todos los derechos reservados" Foreground="#585B70" FontSize="11" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
