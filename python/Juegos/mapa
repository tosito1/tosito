        function initNPCs() {
            const bodyGeo = new THREE.BoxGeometry(0.4, 0.6, 0.2);
            const limbGeo = new THREE.BoxGeometry(0.12, 0.5, 0.12);
            const headGeo = new THREE.BoxGeometry(0.22, 0.25, 0.22);
            
