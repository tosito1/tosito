<Window x:Class="Optimizador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tosito Optimizer V2" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <!-- Colores Globales Dark Theme (Catppuccin Mocha inspired) -->
        <Color x:Key="BgDarkColor">#1E1E2E</Color>
        <Color x:Key="BgSidebarColor">#181825</Color>
        <Color x:Key="AccentColor">#89B4FA</Color>
        <Color x:Key="CardBgColor">#313244</Color>
        <Color x:Key="TextColorPrimary">#CDD6F4</Color>
        <Color x:Key="TextColorSecondary">#A6ADC8</Color>
        
        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
        <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextColorPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextColorSecondary}"/>

        <!-- Estilos Modernos -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SubHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="ParagraphStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#F38BA8"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Toggle Switch Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Background" Background="#45475A" CornerRadius="12" Width="50" Height="24"/>
                            <Ellipse x:Name="Dot" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="26" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDarkBrush}" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.ColumnSpan="2" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Tosito Optimizer V2.1 PREMIUM" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="_" Foreground="{StaticResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" FontSize="16" Width="40" Click="BtnMinimize_Click"/>
                    <Button Content="✕" Foreground="#F38BA8" Background="Transparent" BorderThickness="0" FontSize="14" Width="40" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Sidebar -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgSidebarBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="PANEL PRINCIPAL" Foreground="#585B70" FontSize="11" FontWeight="Bold" Margin="25,0,0,10"/>
                        <RadioButton Content="📊 Dashboard" Style="{StaticResource MenuButtonStyle}" IsChecked="True" Checked="Menu_Dashboard_Checked"/>
                        <RadioButton Content="⚙️ Procesos" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Processes_Checked"/>
                        
                        <TextBlock Text="LIMPIEZA" Foreground="#585B70" FontSize="11" FontWeight="Bold" Margin="25,20,0,10"/>
                        <RadioButton Content="🗑️ Archivos Templ" Style="{StaticResource MenuButtonStyle}" Checked="Menu_TempFiles_Checked"/>
                        <RadioButton Content="🔍 Caché Web" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Cache_Checked"/>
                        <RadioButton Content="♻️ Papelera" Style="{StaticResource MenuButtonStyle}" Checked="Menu_RecycleBin_Checked"/>

                        <TextBlock Text="HERRAMIENTAS PRO" Foreground="#585B70" FontSize="11" FontWeight="Bold" Margin="25,20,0,10"/>
                        <RadioButton Content="🚀 V2 Mega Tools" Style="{StaticResource MenuButtonStyle}" Checked="Menu_MegaTools_Checked"/>
                        <RadioButton Content="🛡️ Privacidad" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Privacy_Checked"/>
                        <RadioButton Content="🎮 Game Booster" Style="{StaticResource MenuButtonStyle}" Checked="Menu_GameBooster_Checked"/>
                        <RadioButton Content="🗑️ Limpieza Profunda" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Debloater_Checked"/>
                        <RadioButton Content="📂 Carpetas Olvidadas" Style="{StaticResource MenuButtonStyle}" Checked="Menu_JunkFolders_Checked"/>

                        <TextBlock Text="CONTROL TOTAL" Foreground="#585B70" FontSize="11" FontWeight="Bold" Margin="25,20,0,10"/>
                        <RadioButton Content="📱 Vinculación Móvil" Style="{StaticResource MenuButtonStyle}" Checked="Menu_MobileLink_Checked"/>
                        <RadioButton Content="🚀 Gestor de Inicio" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Startup_Checked"/>
                        <RadioButton Content="🔧 Servicios" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Services_Checked"/>
                        <RadioButton Content="🌐 Monitor Red" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Network_Checked"/>
                        <RadioButton Content="💻 Hardware" Style="{StaticResource MenuButtonStyle}" Checked="Menu_Hardware_Checked"/>

                        <TextBlock Text="CONFIGURACION" Foreground="#585B70" FontSize="11" FontWeight="Bold" Margin="25,20,0,10"/>
                        <RadioButton Content="⚙️ Ajustes Remotos" Style="{StaticResource MenuButtonStyle}" Checked="Menu_RemoteSettings_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main Content Areas -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="30">
                
                <!-- 1. DASHBOARD -->
                <Grid x:Name="View_Dashboard" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="0,0,0,20">
                            <!-- Hero Section -->
                            <Border CornerRadius="15" Margin="0,0,0,20" Padding="30">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1E1E2E" Offset="0"/>
                                        <GradientStop Color="#313244" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="GreetingText" Text="¡Hola, Tosito!" FontSize="32" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                        <TextBlock Name="DashboardStatus" Text="Analizando el rendimiento de tu PC..." Foreground="#A6ADC8" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button Content="🚀 Análisis Completo" Style="{StaticResource ModernButtonStyle}" Click="AnalyzeSystemButton_Click" Margin="0,0,10,0"/>
                                            <Button Content="⚙️ Ver Detalles" Style="{StaticResource ModernButtonStyle}" Background="#45475A" Foreground="White" Click="Menu_Hardware_Checked"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Ellipse Width="120" Height="120" Stroke="#181825" StrokeThickness="10"/>
                                        <Ellipse x:Name="ScoreRing" Width="120" Height="120" Stroke="{StaticResource AccentBrush}" StrokeThickness="10" 
                                                 StrokeDashArray="1" StrokeDashOffset="1" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="ScoreText" Text="--" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="SALUD" FontSize="10" FontWeight="Bold" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                             <!-- Stats Cards -->
                            <UniformGrid Columns="3">
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="20" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="🧠 MEMORIA RAM" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                                        <TextBlock Name="MemoryPercentText" Text="--%" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <ProgressBar Name="MemoryProgressBar" Height="6" Margin="0,10" Background="#181825" Foreground="{StaticResource AccentBrush}" Value="0"/>
                                        <TextBlock Name="MemoryAvailableText" Text="Cargando..." Foreground="#A6ADC8" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="20" Margin="5,0,5,10">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ PROCESOS" FontSize="11" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,10"/>
                                        <TextBlock Name="ProcessCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Hilos activos en ejecución" Foreground="#A6ADC8" FontSize="12" Margin="0,10,0,0"/>
                                        <Button Content="Ver Todos →" Background="Transparent" Foreground="#F9E2AF" BorderThickness="0" Padding="0" Margin="0,5,0,0" HorizontalAlignment="Left" Cursor="Hand" Click="Menu_Processes_Checked"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="20" Margin="10,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="🗑️ BASURA" FontSize="11" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,0,10"/>
                                        <TextBlock Name="TempCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Archivos temporales" Foreground="#A6ADC8" FontSize="12" Margin="0,10,0,0"/>
                                        <Button Content="Limpiar Basura" Style="{StaticResource DangerButtonStyle}" Margin="0,15,0,0" Padding="10,5" Click="QuickCleanButton_Click"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Live Charts Section -->
                             <UniformGrid Columns="2" Margin="0,10,0,0">
                                <!-- CPU Chart -->
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="15" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="📈 RENDIMIENTO CPU (%)" FontSize="11" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,10"/>
                                        <Canvas Name="CpuChartCanvas" Height="80">
                                            <!-- Grid Lines -->
                                            <Canvas.CacheMode>
                                                <BitmapCache/>
                                            </Canvas.CacheMode>
                                            <Canvas.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#181825">
                                                                <GeometryDrawing.Geometry>
                                                                    <RectangleGeometry Rect="0,0,20,20" />
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                            <GeometryDrawing>
                                                                <GeometryDrawing.Pen>
                                                                    <Pen Brush="#24273A" Thickness="1" />
                                                                </GeometryDrawing.Pen>
                                                                <GeometryDrawing.Geometry>
                                                                    <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Canvas.Background>
                                            <Polyline Name="CpuLine" Stroke="#A6E3A1" StrokeThickness="2"/>
                                        </Canvas>
                                    </StackPanel>
                                </Border>
                                <!-- RAM Chart -->
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="15" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="📈 HISTORIAL RAM (%)" FontSize="11" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                                        <Canvas Name="RamChartCanvas" Height="80">
                                            <!-- Grid Lines -->
                                            <Canvas.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="#181825">
                                                                <GeometryDrawing.Geometry>
                                                                    <RectangleGeometry Rect="0,0,20,20" />
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                            <GeometryDrawing>
                                                                <GeometryDrawing.Pen>
                                                                    <Pen Brush="#24273A" Thickness="1" />
                                                                </GeometryDrawing.Pen>
                                                                <GeometryDrawing.Geometry>
                                                                    <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Canvas.Background>
                                            <Polyline Name="RamLine" Stroke="#89B4FA" StrokeThickness="2"/>
                                        </Canvas>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Game Booster Panel -->
                            <Border x:Name="GameBoosterPanel" Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="25" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🚀" FontSize="40" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="MODO GAME BOOSTER" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DashGameBoosterStatus" Text="La optimización extrema está desactivada." Foreground="#A6ADC8" FontSize="13" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="CheckGameBooster" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="CheckGameBooster_Click"/>
                                </Grid>
                            </Border>

                            <!-- Optimization Panel -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="25" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Optimización en un clic" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                        <TextBlock Text="Libera memoria, detiene procesos basura y limpia el registro automáticamente." Foreground="#A6ADC8" FontSize="14" TextWrapping="Wrap" Margin="0,0,20,0"/>
                                        <TextBlock Name="QuickCleanStatus" Text="" Foreground="#A6E3A1" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🚀 OPTIMIZAR AHORA" Style="{StaticResource ModernButtonStyle}" Height="60" Padding="20,0" Click="FreeMemoryButton_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#89B4FA" Offset="0"/>
                                                <GradientStop Color="#CBA6F7" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. PROCESSES -->
                <Grid x:Name="View_Processes" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Procesos Activos" Style="{StaticResource HeaderTextStyle}"/>
                        <ListBox Grid.Row="1" Name="ProcessesList" Background="{StaticResource BgSidebarBrush}" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PID}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Content="Actualizar Lista" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Margin="0,15,0,0" Click="RefreshProcessesButton_Click"/>
                    </Grid>
                </Grid>

                <!-- 3. TEMP FILES -->
                <Grid x:Name="View_TempFiles" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Archivos Temporales" Style="{StaticResource HeaderTextStyle}"/>
                        <ListBox Grid.Row="1" Name="TempFilesList" Background="{StaticResource BgSidebarBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Size}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <TextBlock Name="TempStatusText" Text="" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Content="Escanear" Style="{StaticResource ModernButtonStyle}" Click="ScanTempButton_Click" Margin="0,0,10,0"/>
                            <Button Content="Limpiar Todo" Style="{StaticResource DangerButtonStyle}" Click="CleanTempButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 4. CACHE -->
                <Grid x:Name="View_Cache" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Caché de Navegadores" Style="{StaticResource HeaderTextStyle}"/>
                        <ListBox Grid.Row="1" Name="CacheList" Background="{StaticResource BgSidebarBrush}">
                             <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Size}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <TextBlock Name="CacheStatusText" Text="" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Content="Escanear" Style="{StaticResource ModernButtonStyle}" Click="ScanCacheButton_Click" Margin="0,0,10,0"/>
                            <Button Content="Limpiar Caché" Style="{StaticResource DangerButtonStyle}" Click="CleanCacheButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 5. RECYCLE BIN -->
                <Grid x:Name="View_RecycleBin" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Papelera de Reciclaje" Style="{StaticResource HeaderTextStyle}"/>
                        <ListBox Grid.Row="1" Name="RecycleBinList" Background="{StaticResource BgSidebarBrush}">
                             <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Size}" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <TextBlock Name="RecycleBinStatusText" Text="" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
