        function renderMapContent(ctx, cW, cH, cx, cz, scale, isFullscreen, pX, pZ) {
            ctx.save(); ctx.fillStyle = mapColors.bg; ctx.fillRect(0, 0, cW, cH);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)'; ctx.lineWidth = 1; ctx.beginPath();
            for(let i=0; i<cW; i+=30) { ctx.moveTo(i,0); ctx.lineTo(i,cH); }
            for(let i=0; i<cH; i+=30) { ctx.moveTo(0,i); ctx.lineTo(cW,i); }
            ctx.stroke();

            ctx.translate(cW/2, cH/2); if (!isFullscreen) ctx.rotate(-cameraAngles.theta); ctx.scale(scale, scale); ctx.translate(-cx, -cz);
            ctx.shadowColor = 'rgba(0,0,0,0.5)'; ctx.shadowBlur = 10; ctx.shadowOffsetX = 4; ctx.shadowOffsetY = 4;
            
            sidewalks.forEach(sw => {
                const bw = sw.w || BLOCK_SIZE - ROAD_WIDTH;
                ctx.fillStyle = (Math.abs(sw.x - BLOCK_SIZE/2) < BLOCK_SIZE && Math.abs(sw.z - BLOCK_SIZE/2) < BLOCK_SIZE && sw.x - BLOCK_SIZE/2===0 && sw.z - BLOCK_SIZE/2===0) ? mapColors.park : mapColors.block;
                ctx.fillRect(sw.x - bw/2, sw.z - bw/2, bw, bw);
                ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 2; ctx.strokeRect(sw.x - bw/2, sw.z - bw/2, bw, bw);
            });

            ctx.fillStyle = mapColors.building;
            buildings.forEach(box => {
                const w = box.max.x - box.min.x; const h = box.max.z - box.min.z;
                ctx.fillRect(box.min.x, box.min.z, w, h);
                ctx.strokeStyle = 'rgba(0,0,0,0.5)'; ctx.lineWidth = 1; ctx.strokeRect(box.min.x, box.min.z, w, h);
            });

            let pois = [ {x: CARTEL_X, z: CARTEL_Z, c: mapColors.cartel, i: '🏭'}, {x: DEALER_X, z: DEALER_Z, c: mapColors.dealer, i: '🚗'}, {x: ARMORY_X, z: ARMORY_Z, c: mapColors.armory, i: '🔫'} ];
            pois.forEach(p => {
                const bx = p.x + BLOCK_SIZE/2; const bz = p.z + BLOCK_SIZE/2;
                ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(bx, bz, 35, 0, Math.PI*2); ctx.fill();
                ctx.strokeStyle = '#fff'; ctx.lineWidth = 4; ctx.stroke();
                ctx.fillStyle = '#fff'; ctx.font = '30px Arial'; ctx.textAlign = 'center'; ctx.textBaseline='middle'; ctx.fillText(p.i, bx, bz + 2);
            });

            ctx.shadowColor = 'transparent';
            
            if (waypoint) { 
                ctx.beginPath(); ctx.moveTo(pX, pZ); ctx.lineTo(waypoint.x, waypoint.z); 
                ctx.strokeStyle = mapColors.route; ctx.lineWidth = 12; ctx.setLineDash([30, 20]); ctx.lineDashOffset = -Date.now()/20; 
                ctx.shadowColor = mapColors.route; ctx.shadowBlur = 20; ctx.stroke(); 
                ctx.setLineDash([]); ctx.shadowBlur = 0; 
                ctx.fillStyle = mapColors.route; ctx.beginPath(); ctx.arc(waypoint.x, waypoint.z, 25, 0, Math.PI*2); ctx.fill();
                ctx.strokeStyle = 'white'; ctx.lineWidth = 6; ctx.stroke();
            }

            ctx.translate(pX, pZ); 
            let coneAngle = cameraAngles.theta; if (isFullscreen) coneAngle = -cameraAngles.theta;
            ctx.rotate(-coneAngle);
            
            // View cone with gradient
            const coneGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, 180);
            coneGrad.addColorStop(0, 'rgba(56, 189, 248, 0.4)');
            coneGrad.addColorStop(1, 'rgba(56, 189, 248, 0)');
            ctx.fillStyle = coneGrad; 
            ctx.beginPath(); ctx.moveTo(0,0); ctx.arc(0, 0, 180, -Math.PI*0.3 - Math.PI/2, Math.PI*0.3 - Math.PI/2); ctx.lineTo(0,0); ctx.fill();

            // Radar pulse
            if (!isFullscreen) {
                const pulse = (Date.now() % 2000) / 2000;
                ctx.strokeStyle = `rgba(56, 189, 248, ${1 - pulse})`;
                ctx.lineWidth = 2;
                ctx.beginPath(); ctx.arc(0, 0, pulse * 200, 0, Math.PI*2); ctx.stroke();
            }

            ctx.shadowColor = mapColors.player; ctx.shadowBlur = 25; ctx.fillStyle = mapColors.player; 
            ctx.beginPath(); ctx.moveTo(0, -40); ctx.lineTo(20, 20); ctx.lineTo(-20, 20); ctx.closePath(); ctx.fill(); 
            ctx.restore();

            if(!isFullscreen) {
                ctx.save(); ctx.translate(cW/2, cH/2); ctx.rotate(-cameraAngles.theta);
                ctx.fillStyle = '#ef4444'; ctx.shadowColor = '#ef4444'; ctx.shadowBlur = 15;
                ctx.beginPath(); ctx.moveTo(0, -cH/2 + 15); ctx.lineTo(10, -cH/2 + 40); ctx.lineTo(-10, -cH/2 + 40); ctx.fill();
                ctx.restore();
            }
        }

        function updateBeacon() {
            if (gpsBeaconLine) { scene.remove(gpsBeaconLine); gpsBeaconLine = null; } if (gpsBeaconBeam) { scene.remove(gpsBeaconBeam); gpsBeaconBeam = null; }
            if (waypoint) {
