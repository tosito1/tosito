                            <CheckBox Name="SelectAllJunkCheck" Content="Seleccionar todo" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Click="SelectAllJunk_Click"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" Name="JunkFoldersList" Background="{StaticResource BgSidebarBrush}" BorderThickness="0" Margin="0,0,0,15">
