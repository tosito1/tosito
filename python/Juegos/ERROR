// --- FUNCIONES AUXILIARES ---
const generateBag = () => {
    let bag = [];
    let idCounter = 0;
    TILE_DISTRIBUTION.forEach(dist => {
        for (let i = 0; i < dist.count; i++) {
            bag.push({ id: `t_${idCounter++}`, letter: dist.letter, value: dist.value, isBlank: dist.letter === '' });
        }
    });
    for (let i = bag.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [bag[i], bag[j]] = [bag[j], bag[i]];
    }
    return bag;
};

const generateEmptyBoard = () => {
    let b = [];
    for (let r = 0; r < BOARD_SIZE; r++) {
        let row = [];
        for (let c = 0; c < BOARD_SIZE; c++) {
            row.push({ r, c, mult: MULTIPLIERS[`${r},${c}`] || '', tile: null, locked: false });
        }
        b.push(row);
    }
    return b;
};

const normalizeWord = (w) => {
    return w.toUpperCase()
        .replace(/[ÁÄÀÂ]/g, 'A')
        .replace(/[ÉËÈÊ]/g, 'E')
        .replace(/[ÍÏÌÎ]/g, 'I')
        .replace(/[ÓÖÒÔ]/g, 'O')
        .replace(/[ÚÜÙÛ]/g, 'U');
};

const AnimatedNumber = ({ value }) => {
    const [displayValue, setDisplayValue] = useState(value);
    const valueRef = useRef(value);
    useEffect(() => {
        if (!window.gsap) { setDisplayValue(value); return; }
        const obj = { val: valueRef.current };
        window.gsap.to(obj, { val: value, duration: 1, ease: "power3.out", onUpdate: () => setDisplayValue(Math.round(obj.val)) });
        valueRef.current = value;
    }, [value]);
    return <span>{ displayValue } </span>;
};

