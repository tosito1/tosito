            scene.add(npcInstances, npcArmL, npcArmR, npcLegL, npcLegR, npcHead);
            
            for(let i=0; i<MAX_NPCS; i++) {
                const sw = sidewalks[Math.floor(Math.random() * sidewalks.length)];
                npcs.push({
                    pos: new THREE.Vector3(sw.x + (Math.random()-0.5)*20, 0.3, sw.z + (Math.random()-0.5)*20),
                    dir: Math.random() * Math.PI * 2,
                    speed: 1.5 + Math.random(),
                    cycle: Math.random() * 10
                });
            }
        }

        function updateNPCs(delta) {
            const dummy = new THREE.Object3D();
            npcs.forEach((n, i) => {
                n.cycle += delta * n.speed * 2.5;
                n.pos.x += Math.cos(n.dir) * n.speed * delta;
                n.pos.z += Math.sin(n.dir) * n.speed * delta;
                
                // Wrap around
                if (Math.abs(n.pos.x) > HALF_CITY) n.pos.x = -Math.sign(n.pos.x) * HALF_CITY;
                if (Math.abs(n.pos.z) > HALF_CITY) n.pos.z = -Math.sign(n.pos.z) * HALF_CITY;

                // Body
                dummy.position.set(n.pos.x, n.pos.y + 1.1, n.pos.z);
                dummy.rotation.y = -n.dir + Math.PI/2;
                dummy.position.y += Math.abs(Math.sin(n.cycle)) * 0.05;
                dummy.updateMatrix(); npcInstances.setMatrixAt(i, dummy.matrix);
                
                // Limbs
                const limbY = n.pos.y + 1.1;
                dummy.position.set(n.pos.x, limbY + 0.5, n.pos.z);
                dummy.updateMatrix(); npcHead.setMatrixAt(i, dummy.matrix);
                
                const swing = Math.sin(n.cycle) * 0.5;
                // Arms
                dummy.position.set(n.pos.x, limbY + 0.2, n.pos.z); dummy.rotation.x = swing;
                dummy.updateMatrix(); npcArmL.setMatrixAt(i, dummy.matrix);
                dummy.rotation.x = -swing;
                dummy.updateMatrix(); npcArmR.setMatrixAt(i, dummy.matrix);
                // Legs
                dummy.position.set(n.pos.x, limbY - 0.3, n.pos.z); dummy.rotation.x = -swing;
                dummy.updateMatrix(); npcLegL.setMatrixAt(i, dummy.matrix);
                dummy.rotation.x = swing;
                dummy.updateMatrix(); npcLegR.setMatrixAt(i, dummy.matrix);
            });
            npcInstances.instanceMatrix.needsUpdate = true;
            npcHead.instanceMatrix.needsUpdate = true;
            npcArmL.instanceMatrix.needsUpdate = true;
            npcArmR.instanceMatrix.needsUpdate = true;
            npcLegL.instanceMatrix.needsUpdate = true;
            npcLegR.instanceMatrix.needsUpdate = true;
        }

