        function handleInteraction() {
            if (interactCooldown > 0) return;
            interactCooldown = 1.0; 

            if (!inVehicle && closestInteractable) {
                if (closestInteractable.type === 'weapon') {
                    // Check if already in inventory
                    if(inventory.find(i => i && i.id === closestInteractable.weaponId)) {
                        showToast("YA TIENES ESTA ARMA", '#ef4444');
                        return;
                    }

                    if (playerMoney >= closestInteractable.price) {
                        playerMoney -= closestInteractable.price; document.getElementById('money-val').innerText = playerMoney;
                        
                        // Añadir al inventario
                        let added = false;
                        for(let i=0; i<maxSlots; i++) {
                            if(!inventory[i]) {
                                inventory[i] = { id: closestInteractable.weaponId, name: closestInteractable.name, icon: closestInteractable.icon, type: 'weapon' };
                                added = true;
                                break;
                            }
                        }
                        
                        if(!added) {
                            showToast("INVENTARIO LLENO", '#ef4444');
                            playerMoney += closestInteractable.price; // Refund
                            return;
                        }

                        scene.remove(closestInteractable.mesh); groundItems = groundItems.filter(i => i !== closestInteractable); 
                        showToast(`AÑADIDO: ${closestInteractable.name}`, '#22c55e'); 
                        equipWeapon(closestInteractable.weaponId); 
                    } else showToast("FONDOS INSUFICIENTES", '#ef4444');
                    return;
                }
                if (closestInteractable.isForSale) {
                    if (playerMoney >= closestInteractable.price) {
                        playerMoney -= closestInteractable.price; document.getElementById('money-val').innerText = playerMoney;
                        closestInteractable.isForSale = false; showToast("VEHÍCULO ADQUIRIDO", '#22c55e');
