        if (!roomState || !user) return false;
        const myData = roomState.players[user.uid];
        if (!myData || myData.diamonds < amount) { showError("Sin diamantes"); return false; }
        const newPlayers = { ...roomState.players };
        newPlayers[user.uid].diamonds -= amount;
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), { players: newPlayers });
        return true;
    };

    const activateRadar = async () => {
        if (!isMyTurn || pendingPlacements.length > 0) return;
        if (!await deductDiamonds(10)) return;
        const typedBoard = roomState.board;
        const isFirstTurn = typedBoard[7][7].tile === null;
        let h = [];
        if (isFirstTurn) h.push({ r: 7, c: 7 });
        else {
            for (let r = 0; r < 15; r++) {
                for (let c = 0; c < 15; c++) {
                    if (!typedBoard[r][c].tile) {
                        const dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]];
                        if (dirs.some(d => { const nr = r + d[0], nc = c + d[1]; return nr >= 0 && nr < 15 && nc >= 0 && nc < 15 && typedBoard[nr][nc].tile; })) h.push({ r, c });
                    }
                }
            }
        }
        setHintHighlights(h);
        spawnFloatingText("¡RADAR!", "body");
        setTimeout(() => setHintHighlights([]), 6000);
    };

    const activateMagicSwap = async () => {
        if (!isMyTurn || pendingPlacements.length > 0 || roomState.bag.length === 0) return;
        if (!await deductDiamonds(10)) return;
        let currentBag = [...roomState.bag];
        let newRack = [...localRack];
        let indices = newRack.map((t, i) => t ? i : null).filter(i => i !== null).sort(() => Math.random() - 0.5).slice(0, 3);
        indices.forEach(idx => { currentBag.push(newRack[idx]); newRack[idx] = null; });
        currentBag.sort(() => Math.random() - 0.5);
        indices.forEach(idx => { if (currentBag.length) newRack[idx] = currentBag.pop(); });
        const newPlayers = { ...roomState.players }; newPlayers[user.uid].rack = newRack;
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), { bag: currentBag, players: newPlayers });
        setLocalRack(newRack);
        spawnFloatingText("¡MAGIA!", "body");
    };

    const spinRoulette = async () => {
        if (!isMyTurn || isSpinning || !await deductDiamonds(10)) return;
        setIsSpinning(true); setHintResult(null);
        const tier = Math.random() < 0.4 ? 'Normal' : (Math.random() < 0.7 ? 'Buena' : 'Mejor');
        if (window.gsap) {
            window.gsap.to(".roulette-wheel", { rotation: 1800 + (Math.random() * 360), duration: 3, ease: "power4.out", onComplete: () => { generateHintWords(tier); setIsSpinning(false); } });
        } else { generateHintWords(tier); setIsSpinning(false); }
    };

    const generateHintWords = (tier) => {
        const letters = localRack.filter(t => t).map(t => t.letter);
        const words = Array.from(dictionary).filter(w => w.length >= 2 && w.length <= 7 && canBeMadeFrom(w, letters)).sort((a, b) => b.length - a.length);
        if (!words.length) return setHintResult({ tier: 'Error', text: 'No se encontraron palabras.' });
        const word = words[tier === 'Mejor' ? 0 : Math.floor(words.length / 2)];
        setHintResult({ tier, text: `Sugiero: ${word}` });
    };

    // Previsión de jugada
    useEffect(() => {
        if (!isMyTurn || !pendingPlacements.length || !roomState) { setPreview({ valid: false, score: 0, words: [], error: '' }); return; }
        const sameRow = pendingPlacements.every(p => p.r === pendingPlacements[0].r);
        const sameCol = pendingPlacements.every(p => p.c === pendingPlacements[0].c);
        if (!sameRow && !sameCol) return setPreview({ valid: false, score: 0, words: [], error: 'No alineadas' });

        const typedBoard = roomState.board;
        const isFirstTurn = typedBoard[7][7].tile === null;
        const coversCenter = pendingPlacements.some(p => p.r === 7 && p.c === 7);
        if (isFirstTurn && !coversCenter) return setPreview({ valid: false, score: 0, words: [], error: 'Tocar estrella' });

        let score = pendingPlacements.reduce((s, p) => s + p.tile.value, 0);
        setPreview({ valid: true, score, words: [{ word: '...', points: score }], error: '' });
    }, [pendingPlacements, isMyTurn, roomState]);

    const handlePlay = async () => {
        if (!preview.valid) return;
        let newBoard = roomState.board.map(row => row.map(c => ({ ...c })));
        pendingPlacements.forEach(p => { newBoard[p.r][p.c].tile = p.tile; newBoard[p.r][p.c].locked = true; });
        let newBag = [...roomState.bag];
        let newRack = [...localRack];
        for (let i = 0; i < 7; i++) { if (newRack[i] === null && newBag.length) newRack[i] = newBag.pop(); }
        const nextTurn = (roomState.turnIndex + 1) % roomState.playerIds.length;
        const newPlayers = { ...roomState.players };
        newPlayers[user.uid].score += preview.score;
        newPlayers[user.uid].rack = newRack;
        const log = { id: Date.now(), text: `${newPlayers[user.uid].name} jugó (+${preview.score})`, icon: '✨' };
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), {
            board: JSON.stringify(newBoard), bag: newBag, players: newPlayers, turnIndex: nextTurn, turnStartTime: Date.now(), logs: [...(roomState.logs || []), log].slice(-5)
        });
        setPendingPlacements([]);
    };

    const skipTurn = async (forced = false) => {
        if (!isMyTurn) return;
        const nextTurn = (roomState.turnIndex + 1) % roomState.playerIds.length;
        const log = { id: Date.now(), text: `${roomState.players[user.uid].name} pasó`, icon: '⏭️' };
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), {
            turnIndex: nextTurn, turnStartTime: Date.now(), logs: [...(roomState.logs || []), log].slice(-5)
        });
    };

    const swapTiles = async () => {
        if (!isMyTurn || roomState.bag.length === 0) return;
        let currentBag = [...roomState.bag];
        let newRack = [...localRack];
        newRack.forEach((t, i) => { if (t) { currentBag.push(t); newRack[i] = null; } });
        currentBag.sort(() => Math.random() - 0.5);
        newRack.forEach((t, i) => { if (currentBag.length) newRack[i] = currentBag.pop(); });
        const nextTurn = (roomState.turnIndex + 1) % roomState.playerIds.length;
        const newPlayers = { ...roomState.players };
        newPlayers[user.uid].rack = newRack;
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), {
            bag: currentBag, players: newPlayers, turnIndex: nextTurn, turnStartTime: Date.now()
        });
        setLocalRack(newRack);
    };

    const showError = (msg) => { setErrorMsg(msg); setTimeout(() => setErrorMsg(''), 3000); };

    const spawnFloatingText = (text, parent) => {
        const el = document.createElement('div');
        el.className = 'fixed top-1/2 left-1/2 -translate-x-1/2 z-[200] font-black text-2xl text-emerald-400 drop-shadow-lg pointer-events-none';
        el.innerText = text;
        document.body.appendChild(el);
        if (window.gsap) window.gsap.to(el, { y: -100, opacity: 0, duration: 1.5, onComplete: () => el.remove() });
        else setTimeout(() => el.remove(), 1500);
    };

    const spawnEmote = (emoji, isMe) => {
        const el = document.createElement('div');
        el.className = `fixed ${isMe ? 'bottom-32 left-8' : 'top-32 right-8'} z-[100] text-6xl pointer-events-none`;
        el.innerText = emoji;
        document.body.appendChild(el);
        if (window.gsap) window.gsap.fromTo(el, { scale: 0 }, { scale: 1.5, duration: 0.5, onComplete: () => { window.gsap.to(el, { opacity: 0, duration: 1, delay: 1, onComplete: () => el.remove() }) } });
        else setTimeout(() => el.remove(), 2000);
    };

    const sendEmote = async (emoji) => {
        setShowEmotes(false);
        await updateDoc(doc(db, 'artifacts', globalAppId, 'public', 'data', 'palabritas_rooms', roomCode), {
            lastEmote: { uid: user.uid, emoji, id: Date.now() }
        });
    };

    const handleRackClick = (i) => {
        if (!isMyTurn) return;
        if (selectedRackIdx === i) setSelectedRackIdx(null);
        else if (localRack[i]) setSelectedRackIdx(i);
    };

    const handleBoardClick = (r, c) => {
        if (!isMyTurn) return;
        const p = pendingPlacements.find(x => x.r === r && x.c === c);
        if (p) {
            setPendingPlacements(pendingPlacements.filter(x => x !== p));
            let nr = [...localRack]; nr[p.rackIdx] = p.tile; setLocalRack(nr);
        } else if (selectedRackIdx !== null && !displayBoard[r][c].tile) {
            const tile = localRack[selectedRackIdx];
            setPendingPlacements([...pendingPlacements, { r, c, tile, rackIdx: selectedRackIdx }]);
            let nr = [...localRack]; nr[selectedRackIdx] = null; setLocalRack(nr); setSelectedRackIdx(null);
        }
    };

    const shuffleRack = () => {
        let nr = [...localRack];
        const tiles = nr.filter(t => t);
        tiles.sort(() => Math.random() - 0.5);
        let ptr = 0;
        for (let i = 0; i < 7; i++) { if (nr[i]) nr[i] = tiles[ptr++]; }
        setLocalRack(nr);
    };

    if (!user) {
        return (
            <div className= "fixed inset-0 bg-slate-950 flex items-center justify-center p-4" >
            <div className="bg-slate-900 p-10 rounded-[2.5rem] shadow-2xl border border-white/5 flex flex-col items-center max-w-sm w-full text-center" >
                <div className="w-20 h-20 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-3xl flex items-center justify-center shadow-lg mb-8 rotate-3" >
                    <span className="text-4xl font-black text-white" > P </span>
                        </div>
                        < h1 className = "text-3xl font-black text-white mb-2 uppercase italic tracking-tighter" > Palabritas < span className = "text-rose-500" > GO < /span></h1 >
                            <p className="text-slate-400 font-bold text-sm mb-10 px-4" > Conéctate para competir con tus amigos y guardar tu progreso.</p>

                                < button
        onClick = { handleGoogleLogin }
        className = "w-full bg-white text-slate-900 py-4 px-6 rounded-2xl font-black flex items-center justify-center gap-3 hover:bg-slate-100 transition-all active:scale-95 shadow-xl mb-4"
            >
            <svg className="w-5 h-5" viewBox = "0 0 24 24" >
                <path fill="#4285F4" d = "M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                    <path fill="#34A853" d = "M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path fill="#FBBC05" d = "M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" />
                            <path fill="#EA4335" d = "M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                                </svg>
                                ENTRAR CON GOOGLE
            </button>
            < button onClick = {() => window.parent.exitCurrentGame && window.parent.exitCurrentGame()
    } className = "text-slate-500 font-bold hover:text-slate-300 transition-colors" > Volver al menú </button>
        </div>
        </div>
                );
}

// Renderizado Lobby
if (!roomCode || roomState?.status === 'waiting') {
    return (
        <div className= "fixed inset-0 bg-slate-900 flex items-center justify-center p-4" >
        <div className="bg-slate-800 p-8 rounded-3xl shadow-2xl w-full max-w-sm flex flex-col items-center" >
            <div className="flex items-center gap-3 mb-8" >
                <div className="w-10 h-10 rounded-full bg-indigo-500 flex items-center justify-center text-xs font-black" >
                    { user.photoURL ? <img src={ user.photoURL } className = "w-full h-full rounded-full" /> : userName[0]
}
</div>
    < div className = "flex flex-col" >
        <span className="text-white font-black text-sm" > { userName } </span>
            < button onClick = { handleLogout } className = "text-rose-400 text-[10px] font-bold uppercase text-left" > Cerrar Sesión </button>
                </div>
                </div>
                < h1 className = "text-3xl font-black text-white mb-8 uppercase italic" > Palabritas < span className = "text-rose-500" > GO < /span></h1 >
                    {!roomCode ? (
                        <div className= "w-full space-y-4" >
                        <div className="flex gap-2" >
                            <input type="text" value = { joinCode } onChange = { e => setJoinCode(e.target.value.toUpperCase()) } placeholder = "CÓDIGO" className = "w-1/2 bg-slate-900 border border-slate-700 rounded-xl p-4 text-white font-black text-center" />
                                <button onClick={ handleJoinRoom } className = "w-1/2 bg-blue-600 rounded-xl font-black text-white active:scale-95 transition-transform" > UNIRSE </button>
                                    </div>
                                    < button onClick = { handleCreateRoom } className = "w-full bg-rose-600 py-4 rounded-xl font-black text-white active:scale-95 transition-transform" > CREAR SALA </button>
                                        < button onClick = {() => window.parent.exitCurrentGame && window.parent.exitCurrentGame()} className = "w-full bg-slate-700 py-3 rounded-xl font-bold text-slate-400" > SALIR AL HUB </button>
                                            </div>
                            ) : !roomState ? (
    <div className= "text-white font-bold animate-pulse" > CARGANDO SALA...</div>
                            ) : (
    <div className= "w-full flex flex-col items-center" >
    <div className="text-4xl font-black text-white mb-6 tracking-widest bg-black/20 px-6 py-2 rounded-xl border border-white/5" > { roomCode } </div>
        < div className = "w-full bg-slate-900 p-4 rounded-xl mb-6" >
            <h3 className="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-3" > Jugadores en sala </h3>
{
    roomState.playerIds.map(uid => (
        <div key= { uid } className = "flex items-center gap-3 py-2 text-white font-bold border-b border-white/5 last:border-0" >
        <div className="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center text-xs" > { roomState.players[uid]?.name[0] || '?' } </div>
                                                { roomState.players[uid]?.name || '...' } { uid === roomState.host && '👑'}
</div>
                                        ))}
</div>
{
    user.uid === roomState.host ? (
        <button onClick= { handleStartGame } className = "w-full bg-emerald-600 py-4 rounded-xl font-black text-white shadow-lg active:scale-95 transition-transform" > EMPEZAR PARTIDA </button>
                                    ) : (
        <div className= "text-amber-500 font-bold animate-pulse text-sm" > Esperando al anfitrión...</div>
                                    )
}
<button onClick={ () => setRoomCode('') } className = "mt-4 text-slate-500 text-xs font-bold uppercase" > Abandonar Sala </button>
    </div>
                            )}
</div>
    </div>
                );
            }

// Fallback para cuando roomState es null pero no estamos en el lobby
if (!roomState) return <div className="fixed inset-0 bg-slate-950 flex items-center justify-center text-white font-black animate-pulse" > SINCRONIZANDO...</div>;

const myPlayer = roomState.players[user.uid];

// Renderizado Juego
return (
    <div className= "fixed inset-0 bg-slate-950 flex flex-col items-center justify-center p-2 sm:p-4 overflow-hidden" >
    <div className="absolute top-4 left-4 right-4 flex justify-between items-start pointer-events-none z-50" >
        <div className="flex flex-col gap-2 pointer-events-auto" >
            <div className="bg-slate-900/80 backdrop-blur-md border border-slate-700 px-4 py-2 rounded-2xl flex items-center gap-3" >
                <button onClick={ () => { if (window.confirm("¿Cerrar sesión?")) handleLogout(); } } className = "hover:opacity-80 transition-opacity" >
                    <Icon name="LogOut" size = { 16} className = "text-rose-400" />
                        </button>
                        < span className = "text-white font-black text-xl" > <AnimatedNumber value={ myPlayer?.score || 0 } /></span >
                            </div>
                            < div className = "bg-slate-900/80 backdrop-blur-md border border-slate-700 px-3 py-1 rounded-xl text-cyan-400 text-xs font-bold" >
                                💎 { roomState.players[user.uid].diamonds }
</div>
    </div>
    < div className = "flex flex-col items-end gap-2 pointer-events-auto" >
        <div className={ `px-4 py-2 rounded-2xl border font-black ${isMyTurn ? 'bg-emerald-600 border-emerald-400 text-white' : 'bg-slate-900 border-slate-700 text-slate-400'}` }>
            { isMyTurn? `TU TURNO: ${timeLeft}s` : `TURNO DE ${roomState.players[roomState.playerIds[roomState.turnIndex]]?.name || '...'}`}
</div>
    < button onClick = {() => setShowEmotes(!showEmotes)} className = "w-10 h-10 bg-slate-900 border border-slate-700 rounded-full flex items-center justify-center text-xl" >😊</button>
{
    showEmotes && (
        <div className="bg-slate-900 border border-slate-700 p-2 rounded-2xl grid grid-cols-4 gap-1" >
            { EMOTES.map(e => <button key={ e } onClick = {() => sendEmote(e)} className = "w-8 h-8 flex items-center justify-center text-lg hover:scale-125 transition-transform" > { e } </button>)
}
</div>
                            )}
</div>
    </div>

{/* Tablero */ }
<div className="relative w-full aspect-square max-w-[600px] bg-slate-900 rounded-xl p-1 grid gap-[1px]" style = {{ gridTemplateColumns: 'repeat(15, 1fr)' }}>
{
    displayBoard.map((row, r) => row.map((cell, c) => (
        <div key= {`${r}-${c}`} onClick = {() => handleBoardClick(r, c)} className = {`aspect-square flex items-center justify-center rounded-sm transition-colors ${cell.tile ? 'bg-amber-100 border border-amber-300' : (MULTIPLIERS[`${r},${c}`] === 'TW' ? 'bg-rose-500' : (MULTIPLIERS[`${r},${c}`] === 'DW' ? 'bg-orange-400' : (MULTIPLIERS[`${r},${c}`] === 'TL' ? 'bg-blue-500' : (MULTIPLIERS[`${r},${c}`] === 'DL' ? 'bg-emerald-500' : (r === 7 && c === 7 ? 'bg-indigo-600' : 'bg-slate-800')))))}`}>
            {
                cell.tile ? (
                    <div className= "relative w-full h-full flex flex-col items-center justify-center" >
                    <span className="text-slate-900 font-black text-[clamp(10px,2vw,24px)] leading-none"> { cell.tile.letter } </span>
                        < span className="absolute bottom-0 right-0.5 text-[clamp(6px,1vw,10px)] font-bold text-slate-500" > { cell.tile.value } </span>
                        </div>
                                ) : (
                            <span className="text-[8px] font-bold text-white/20" > { cell.mult } </span>
                        )}
{ hintHighlights.some(h => h.r === r && h.c === c) && <div className="absolute inset-0 border-2 border-cyan-400 animate-pulse" > </div> }
</div>
                        )))}
</div>

{/* Rack */ }
<div className="mt-8 flex flex-col items-center gap-4 w-full max-w-[600px]" >
    <div className="flex gap-2" >
    {
        localRack.map((tile, i) => (
            <div key= { i } onClick = {() => handleRackClick(i)} className = {`w-12 h-14 sm:w-16 sm:h-20 rounded-xl flex flex-col items-center justify-center border-b-4 transition-all ${tile ? (selectedRackIdx === i ? 'bg-emerald-400 border-emerald-600 -translate-y-2' : 'bg-amber-100 border-amber-300 cursor-pointer hover:-translate-y-1') : 'bg-slate-800 border-slate-950 opacity-50'}`}>
                { tile && (
                    <>
                    <span className="text-2xl sm:text-4xl font-black text-slate-900" > { tile.letter } </span>
                        < span className = "text-xs font-bold text-slate-500" > { tile.value } </span>
                            </>
                                    )}
</div>
                            ))}
</div>
    < div className = "flex gap-4 w-full px-4" >
        <button onClick={ shuffleRack } className = "flex-1 bg-slate-800 py-4 rounded-2xl font-black text-white" > BARAJAR </button>
            < button onClick = { swapTiles } disabled = {!isMyTurn} className = "flex-1 bg-blue-600 py-4 rounded-2xl font-black text-white disabled:opacity-50" > CAMBIAR </button>
{
    pendingPlacements.length > 0 ? (
        <button onClick= { handlePlay } className = "flex-[2] bg-emerald-600 py-4 rounded-2xl font-black text-white animate-pulse" > JUGAR(+{ preview.score }) </button>
                            ) : (
        <button onClick= {() => skipTurn(false)
} className = "flex-[2] bg-slate-700 py-4 rounded-2xl font-black text-white" > PASAR </button>
                            )}
</div>
    </div>

{/* Botones Pistas */ }
<div className="absolute bottom-4 right-4 flex flex-col gap-2" >
    <button onClick={ activateRadar } className = "w-12 h-12 bg-indigo-600 rounded-full flex items-center justify-center text-xl shadow-lg" >📡</button>
        < button onClick = { activateMagicSwap } className = "w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center text-xl shadow-lg" >🪄</button>
            < button onClick = {() => setShowHints(true)} className = "w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-xl shadow-lg" >💡</button>
                </div>

{
    showHints && (
        <div className="fixed inset-0 bg-black/80 flex items-center justify-center p-4 z-[100]" >
            <div className="bg-slate-800 p-8 rounded-3xl w-full max-w-sm flex flex-col items-center" >
                <h2 className="text-2xl font-black text-white mb-6 uppercase" > Cerebro IA </h2>
                    < div className = "roulette-wheel w-32 h-32 mb-6 border-4 border-white" > </div>
    {
        hintResult ? (
            <div className= "text-emerald-400 font-bold text-lg mb-6" > { hintResult.text } </div>
                                ) : (
            <button onClick= { spinRoulette } className = "w-full bg-amber-500 py-4 rounded-xl font-black text-orange-950" > GIRAR(10💎) </button>
                                )
    }
    <button onClick={ () => setShowHints(false) } className = "mt-4 text-slate-400 font-bold" > CERRAR </button>
        </div>
        </div>
                    )
}
</div>
            );
        }

const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
    </body>
    </html>
