                        <UniformGrid Columns="2">
                            <!-- Bloque del Código (Pairing Code) -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="30" Margin="0,0,10,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="CÓDIGO DE VINCULACIÓN" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
