        const mapColors = { bg: '#020617', road: '#0f172a', block: '#1e293b', park: '#064e3b', cartel: '#991b1b', dealer: '#0ea5e9', armory: '#dc2626', player: '#38bdf8', viewCone: 'rgba(56, 189, 248, 0.25)', route: '#ef4444', building: '#334155' };

        function drawMap() {
            const mCnv = document.getElementById('minimap-canvas'); const mCtx = mCnv.getContext('2d');
            const fCnv = document.getElementById('fullscreen-map-canvas'); const fCtx = fCnv.getContext('2d');
