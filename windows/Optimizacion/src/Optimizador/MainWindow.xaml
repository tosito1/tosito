                                    <TextBlock Text="Introduce este código en tu App móvil" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,0" HorizontalAlignment="Center" FontSize="12"/>
                                    
                                    <Border Background="#1E1E2E" CornerRadius="8" Padding="15" Margin="0,25,0,0">
                                        <TextBlock Text="⚠️ Este código solo es necesario la primera vez. Una vez vinculado, este PC quedará asociado a tu cuenta para siempre." 
                                                   Foreground="#F9E2AF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Bloque del QR y URL -->
                            <Border Background="{StaticResource CardBgBrush}" CornerRadius="12" Padding="30" Margin="10,0,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="MobileLinkStatus" Text="Iniciando túnel seguro..." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    
                                    <StackPanel Name="MobileLinkResultPanel" Visibility="Collapsed" HorizontalAlignment="Center">
                                        <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,15" HorizontalAlignment="Center">
                                            <Image Name="MobileLinkQrImage" Width="150" Height="150" Stretch="Uniform"/>
                                        </Border>
                                        <TextBox Name="MobileLinkUrlTextBox" Background="#1E1E2E" Foreground="{StaticResource AccentBrush}" Padding="10" BorderThickness="0" FontSize="12" FontWeight="Bold" IsReadOnly="True" TextAlignment="Center" Text="https://..." Width="250"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
