            const skinMat = new THREE.MeshStandardMaterial({ color: 0x8d5524, roughness: 0.8 });
            
            npcInstances = new THREE.InstancedMesh(bodyGeo, npcMat, MAX_NPCS);
            npcArmL = new THREE.InstancedMesh(limbGeo, npcMat, MAX_NPCS);
            npcArmR = new THREE.InstancedMesh(limbGeo, npcMat, MAX_NPCS);
            npcLegL = new THREE.InstancedMesh(limbGeo, npcMat, MAX_NPCS);
